---
import Logo from '@/components/Logo.astro';
import { resolveLocale } from '@/lib/i18n/resolveLocale';

const locale = resolveLocale(Astro);

const authCookie = Astro.cookies.get('auth')?.value;

let user = null;
let business = null;

if (authCookie) {
	try {
		const session = JSON.parse(
			decodeURIComponent(authCookie)
		);

		user = session?.user ?? null;
		business = user?.business ?? null;
	} catch {
		user = null;
		business = null;
	}
}

const userName = user?.name ?? '';
const businessName = business?.name ?? 'IJOBA';

const isEs = locale === 'es';

const permissions: string[] =
	user?.permissions ?? [];

const can = (permission: string) =>
	permissions.includes(permission);

const canViewCases =
	can('cases.view');

const canViewCustomers =
	can('customers.view');

const canViewAnalytics =
	can('analytics.view');

const canViewDocuments =
	can('document_templates.view');
---

<div class="min-h-screen bg-slate-50 dark:bg-slate-950">

	<!-- Hero -->
	<section class="relative overflow-hidden">

		<!-- Decorative background -->
		<div
			class="absolute -top-32 -right-32 h-96 w-96 rounded-full bg-[#0057B7]/10 blur-3xl"
		></div>

		<div
			class="absolute top-48 -left-32 h-80 w-80 rounded-full bg-[#00A86B]/10 blur-3xl"
		></div>

		<div
			class="absolute top-20 right-1/3 h-48 w-48 rounded-full bg-[#FFD700]/10 blur-3xl"
		></div>

		<div
			class="relative mx-auto max-w-7xl px-6 py-12 lg:px-8 lg:py-20"
		>

			<!-- Brand -->
			<div class="mb-16 flex items-center justify-center">
				<Logo
					site={Astro.locals.site}
					widthn="250"
					heightn="100"
					class="h-12 w-auto"
				/>
			</div>

			<div class="grid items-center gap-12 lg:grid-cols-[1.2fr_0.8fr]">

				<!-- Welcome text -->
				<div>

					<div
						class="mb-5 inline-flex items-center gap-2 rounded-full border border-[#0057B7]/10 bg-white px-4 py-2 text-sm font-medium text-[#0057B7] shadow-sm dark:border-slate-800 dark:bg-slate-900"
					>
						<span
							class="h-2 w-2 rounded-full bg-[#00A86B]"
						></span>

						{isEs
							? 'Centro de operaciones'
							: 'Operations center'}
					</div>

					<h1
						class="max-w-3xl text-4xl font-bold tracking-tight text-slate-900 dark:text-white sm:text-5xl lg:text-6xl"
					>
						{isEs
							? 'Bienvenido a'
							: 'Welcome to'}

						<span
							class="block bg-gradient-to-r from-[#0057B7] via-[#0074D9] to-[#00A86B] bg-clip-text text-transparent"
						>
							{businessName}
						</span>
					</h1>

					<p
						class="mt-6 max-w-2xl text-lg leading-8 text-slate-600 dark:text-slate-300"
					>
						{userName
							? (
								isEs
									? `Hola ${userName}. Aquí tienes todo lo necesario para gestionar tu negocio desde un solo lugar.`
									: `Hello ${userName}. Everything you need to manage your business, all in one place.`
							)
							: (
								isEs
									? 'Todo lo que necesitas para gestionar tu negocio desde un solo lugar.'
									: 'Everything you need to manage your business, all in one place.'
							)}
					</p>

					<div class="mt-8 flex flex-wrap gap-3">

						{canViewCases && (
							<a
								href="/dashboard/cases"
								class="inline-flex items-center gap-2 rounded-lg bg-[#0057B7] px-5 py-3 text-sm font-semibold text-white shadow-lg shadow-[#0057B7]/20 transition hover:bg-[#004a9f] focus:outline-none focus:ring-4 focus:ring-[#0057B7]/20"
							>
								<svg
									class="h-5 w-5"
									fill="none"
									viewBox="0 0 24 24"
									stroke="currentColor"
									stroke-width="2"
								>
									<path
										stroke-linecap="round"
										stroke-linejoin="round"
										d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h6l5 5v11a2 2 0 01-2 2z"
									/>
								</svg>

								{isEs ? 'Ver casos' : 'View cases'}
							</a>
						)}

						{canViewCustomers && (
							<a
								href="/dashboard/customers"
								class="inline-flex items-center gap-2 rounded-lg border border-slate-200 bg-white px-5 py-3 text-sm font-semibold text-slate-700 shadow-sm transition hover:border-[#0057B7]/30 hover:text-[#0057B7] dark:border-slate-700 dark:bg-slate-900 dark:text-slate-200"
							>
								<svg
									class="h-5 w-5"
									fill="none"
									viewBox="0 0 24 24"
									stroke="currentColor"
									stroke-width="2"
								>
									<path
										stroke-linecap="round"
										stroke-linejoin="round"
										d="M17 20h5V4H2v16h5m10 0v-5H7v5m10 0H7M7 8h10M7 12h6"
									/>
								</svg>

								{isEs ? 'Clientes' : 'Customers'}
							</a>
						)}

					</div>
				</div>

				<!-- Brand visual -->
				<div class="relative hidden lg:block">

					<div
						class="relative mx-auto flex aspect-square max-w-md items-center justify-center"
					>

						<div
							class="absolute inset-8 rounded-full border border-[#0057B7]/10"
						></div>

						<div
							class="absolute inset-16 rounded-full border border-[#00A86B]/15"
						></div>

						<div
							class="absolute inset-24 rounded-full border border-[#FFD700]/25"
						></div>

						<div
							class="relative flex h-48 w-48 items-center justify-center rounded-3xl bg-white shadow-2xl shadow-[#0057B7]/10 dark:bg-slate-900"
						>
							<div
								class="absolute inset-0 rounded-3xl bg-gradient-to-br from-[#0057B7]/5 via-transparent to-[#00A86B]/10"
							></div>

							<div class="relative text-center">
								<div
									class="text-4xl font-black tracking-[0.2em] text-[#0057B7]"
								>
									IJOBA
								</div>

								<div
									class="mx-auto mt-3 h-1 w-12 rounded-full bg-[#FFD700]"
								></div>

								<p
									class="mt-3 text-xs font-medium uppercase tracking-[0.2em] text-slate-400"
								>
									Business management
								</p>
							</div>
						</div>

						<div
							class="absolute right-4 top-16 flex h-12 w-12 items-center justify-center rounded-xl bg-[#FFD700]/15 text-[#B89500] shadow-sm"
						>
							<svg
								class="h-6 w-6"
								fill="none"
								viewBox="0 0 24 24"
								stroke="currentColor"
								stroke-width="1.8"
							>
								<path
									stroke-linecap="round"
									stroke-linejoin="round"
									d="M12 3l2.09 6.26L20 12l-5.91 2.74L12 21l-2.09-6.26L4 12l5.91-2.74L12 3z"
								/>
							</svg>
						</div>

						<div
							class="absolute bottom-20 left-2 flex h-12 w-12 items-center justify-center rounded-xl bg-[#00A86B]/10 text-[#00A86B] shadow-sm"
						>
							<svg
								class="h-6 w-6"
								fill="none"
								viewBox="0 0 24 24"
								stroke="currentColor"
								stroke-width="1.8"
							>
								<path
									stroke-linecap="round"
									stroke-linejoin="round"
									d="M4 17l6-6 4 4 6-7"
								/>
								<path
									stroke-linecap="round"
									stroke-linejoin="round"
									d="M16 8h4v4"
								/>
							</svg>
						</div>

					</div>

				</div>

			</div>
		</div>
	</section>


	<!-- Main modules -->
	<section class="border-t border-slate-200/70 bg-white dark:border-slate-800 dark:bg-slate-900">

		<div class="mx-auto max-w-7xl px-6 py-16 lg:px-8">

			<div class="mb-10">
				<p
					class="text-sm font-semibold uppercase tracking-wider text-[#0057B7]"
				>
					{isEs ? 'Acceso rápido' : 'Quick access'}
				</p>

				<h2
					class="mt-2 text-2xl font-bold text-slate-900 dark:text-white"
				>
					{isEs
						? 'Gestiona tu operación'
						: 'Manage your operation'}
				</h2>

				<p class="mt-2 max-w-2xl text-slate-500 dark:text-slate-400">
					{isEs
						? 'Accede directamente a las herramientas principales de tu negocio.'
						: 'Access the main tools for your business directly.'}
				</p>
			</div>


			<div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-4">

				<!-- Cases -->
				{canViewCases && (
					<a
						href="/dashboard/cases"
						class="group rounded-2xl border border-slate-200 bg-slate-50 p-6 transition hover:-translate-y-1 hover:border-[#0057B7]/20 hover:bg-white hover:shadow-xl hover:shadow-[#0057B7]/5 dark:border-slate-800 dark:bg-slate-950 dark:hover:bg-slate-900"
					>
						<div
							class="mb-5 flex h-12 w-12 items-center justify-center rounded-xl bg-[#0057B7]/10 text-[#0057B7] transition group-hover:bg-[#0057B7] group-hover:text-white"
						>
							<svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
								<path stroke-linecap="round" stroke-linejoin="round" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h6l5 5v11a2 2 0 01-2 2z" />
							</svg>
						</div>

						<h3 class="font-semibold text-slate-900 dark:text-white">
							{isEs ? 'Casos' : 'Cases'}
						</h3>

						<p class="mt-2 text-sm leading-6 text-slate-500 dark:text-slate-400">
							{isEs
								? 'Gestiona procesos, estados, clientes y documentos.'
								: 'Manage processes, statuses, customers and documents.'}
						</p>
					</a>
				)}


				<!-- Customers -->
				{canViewCustomers && (
					<a
						href="/dashboard/customers"
						class="group rounded-2xl border border-slate-200 bg-slate-50 p-6 transition hover:-translate-y-1 hover:border-[#00A86B]/20 hover:bg-white hover:shadow-xl hover:shadow-[#00A86B]/5 dark:border-slate-800 dark:bg-slate-950 dark:hover:bg-slate-900"
					>
						<div
							class="mb-5 flex h-12 w-12 items-center justify-center rounded-xl bg-[#00A86B]/10 text-[#00A86B] transition group-hover:bg-[#00A86B] group-hover:text-white"
						>
							<svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
								<path stroke-linecap="round" stroke-linejoin="round" d="M17 20h5V4H2v16h5m10 0v-5H7v5m10 0H7M7 8h10M7 12h6" />
							</svg>
						</div>

						<h3 class="font-semibold text-slate-900 dark:text-white">
							{isEs ? 'Clientes' : 'Customers'}
						</h3>

						<p class="mt-2 text-sm leading-6 text-slate-500 dark:text-slate-400">
							{isEs
								? 'Centraliza la información y relación con tus clientes.'
								: 'Centralize customer information and relationships.'}
						</p>
					</a>
				)}


				<!-- Analytics -->
				 {canViewAnalytics && (
					<a
						href="/dashboard/analytics/cases"
						class="group rounded-2xl border border-slate-200 bg-slate-50 p-6 transition hover:-translate-y-1 hover:border-[#FFD700]/40 hover:bg-white hover:shadow-xl hover:shadow-[#FFD700]/5 dark:border-slate-800 dark:bg-slate-950 dark:hover:bg-slate-900"
					>
						<div
							class="mb-5 flex h-12 w-12 items-center justify-center rounded-xl bg-[#FFD700]/15 text-[#A78300] transition group-hover:bg-[#FFD700] group-hover:text-slate-900"
						>
							<svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
								<path stroke-linecap="round" stroke-linejoin="round" d="M4 19V5m0 14h16M8 16v-4m4 4V8m4 8V5" />
							</svg>
						</div>

						<h3 class="font-semibold text-slate-900 dark:text-white">
							{isEs ? 'Analítica' : 'Analytics'}
						</h3>

						<p class="mt-2 text-sm leading-6 text-slate-500 dark:text-slate-400">
							{isEs
								? 'Consulta indicadores y el rendimiento de tu operación.'
								: 'Monitor indicators and operational performance.'}
						</p>
					</a>
				)}


				<!-- Documents -->
				 {canViewDocuments && (
						<a
							href="/dashboard/document-templates"
							class="group rounded-2xl border border-slate-200 bg-slate-50 p-6 transition hover:-translate-y-1 hover:border-[#0057B7]/20 hover:bg-white hover:shadow-xl hover:shadow-[#0057B7]/5 dark:border-slate-800 dark:bg-slate-950 dark:hover:bg-slate-900"
						>
							<div
								class="mb-5 flex h-12 w-12 items-center justify-center rounded-xl bg-[#0057B7]/10 text-[#0057B7] transition group-hover:bg-[#0057B7] group-hover:text-white"
							>
								<svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
									<path stroke-linecap="round" stroke-linejoin="round" d="M7 3h7l5 5v13H7a2 2 0 01-2-2V5a2 2 0 012-2z" />
									<path stroke-linecap="round" stroke-linejoin="round" d="M14 3v6h6M9 13h6M9 17h6" />
								</svg>
							</div>

							<h3 class="font-semibold text-slate-900 dark:text-white">
								{isEs ? 'Documentos' : 'Documents'}
							</h3>

							<p class="mt-2 text-sm leading-6 text-slate-500 dark:text-slate-400">
								{isEs
									? 'Trabaja con plantillas y documentación de tus procesos.'
									: 'Work with templates and process documentation.'}
							</p>
						</a>
				)}

			</div>
		</div>
	</section>

</div>
