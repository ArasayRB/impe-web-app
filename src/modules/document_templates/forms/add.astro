---
// document_templates/forms/add.astro
import {resolveSite} from '@/lib/resolveSite';
import { getServerTranslator } from '@/lib/i18n/server';
import { lang } from '@/lib/i18n/config';
import { resolveLocale } from '@/lib/i18n/resolveLocale';

const site = resolveSite(Astro);
const locale = resolveLocale(Astro);

const t = await getServerTranslator(locale, lang);

---
<div
	class="fixed inset-0 z-50  z-50 items-center justify-center hidden overflow-x-hidden overflow-y-auto top-4 md:inset-0 h-modal sm:h-full"
	id="add-document-templates-modal"
>
	<div class="relative w-full max-w-5xl max-h-[95vh] px-4">
		<!-- Modal content -->
		<div class="relative flex h-full flex-col overflow-hidden bg-white rounded-lg shadow dark:bg-gray-800">
			<!-- Modal header -->
			<div
				class="flex shrink-0 items-start justify-between p-5 border-b rounded-t dark:border-gray-700"
			>
				<h3 data-modal-title class="text-xl font-semibold dark:text-white" data-i18n="common.crud.add">{t('common.crud.add')}</h3>
				<button
					type="button"
					data-close-modal="add-document-templates-modal"
					class="text-gray-400 bg-transparent hover:bg-gray-200 hover:text-gray-900 rounded-lg text-sm p-1.5 ml-auto inline-flex items-center dark:hover:bg-gray-700 dark:hover:text-white"
					{/*data-modal-toggle="add-document-templates-modal"*/}
				>
					<svg
						class="w-5 h-5"
						fill="currentColor"
						viewBox="0 0 20 20"
						xmlns="http://www.w3.org/2000/svg"
						><path
							fill-rule="evenodd"
							d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z"
							clip-rule="evenodd"></path></svg
					>
				</button>
			</div>
			<!-- Modal body -->
			<div class="p-6 space-y-6">
				<!-- unused, now we use tagSelector
				 <div data-customer></div>

				
				<button
					type="button"
					data-open-modal="add-customer-modal"
  				data-from="case"
					class="bg-primary-700 hover:bg-primary-800 focus:ring-4 focus:ring-primary-300 font-medium rounded-lg text-sm px-5 py-2.5 text-center dark:bg-primary-600 dark:hover:bg-primary-700 dark:focus:ring-primary-800 text-white"
				data-i18n="common.crud.add">
				+ {t('common.crud.add')}
				</button>-->

				<div data-form-container></div>

				<div
						id="document-templates-variables"
						class="hidden mt-6 border-t border-gray-200 pt-6 dark:border-gray-700"
				>
				<!-- Modal footer -->
				
			</div>
		</div>
	</div>
</div>
