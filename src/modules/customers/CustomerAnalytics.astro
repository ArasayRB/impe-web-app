---
import { getServerTranslator } from '@/lib/i18n/server';
import { lang } from '@/lib/i18n/config';
import {resolveSite} from '@/lib/resolveSite';
import { resolveLocale } from '@/lib/i18n/resolveLocale';

const { initialData } = Astro.props;
const { class: clazz } = Astro.props;
const site = resolveSite(Astro);
const locale = resolveLocale(Astro);

const t = await getServerTranslator(locale, lang);
---

<analytics-dashboard
  id="customers-analytics-root"

  data-site={JSON.stringify(site)}

  class:list={['block overflow-hidden shadow', clazz]}

  data-initial={JSON.stringify(
    initialData
  )}
>
    <div
		class="shrink-0
			p-4
			bg-white
			border-b
			border-gray-200
			dark:bg-gray-800"
	  >
      <div class="w-full mb-1">
          <div class="mb-4">
            <nav class="flex mb-5" aria-label="Breadcrumb">
              <ol
                class="inline-flex items-center space-x-1 text-sm font-medium md:space-x-2"
              >
                <li class="inline-flex items-center">
                  <a
                    href="#"
                    class="inline-flex items-center text-gray-700 hover:text-primary-600 dark:text-gray-300 dark:hover:text-white"
                  >
                    <svg
                                    class="w-5 h-5 text-gray-500 transition duration-75 group-hover:text-gray-900 dark:text-gray-400 dark:group-hover:text-white"
                                    fill="currentColor"
                                    viewBox="0 0 20 20"
                                    xmlns="http://www.w3.org/2000/svg"
                                    ><path d="M2 10a8 8 0 018-8v8h8a8 8 0 11-16 0z"></path><path
                                        d="M12 2.252A8.014 8.014 0 0117.748 8H12V2.252z"></path></svg
                                >
                    <span data-i18n="sidebar.title.analytics">{t('sidebar.title.analytics')}</span>
                  </a>
                </li>
                <li>
                  <div class="flex items-center">
                    <svg
                      class="w-6 h-6 text-gray-400"
                      fill="currentColor"
                      viewBox="0 0 20 20"
                      xmlns="http://www.w3.org/2000/svg"
                      ><path
                        fill-rule="evenodd"
                        d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z"
                        clip-rule="evenodd"></path></svg
                    >
                    <a
                      href="#"
                      class="ml-1 text-gray-700 hover:text-primary-600 md:ml-2 dark:text-gray-300 dark:hover:text-white"
                      data-i18n="sidebar.dashboard.customers"
                      >{t('sidebar.dashboard.customers')}</a
                    >
                  </div>
                </li>
              </ol>
            </nav>
            <h1
              class="text-xl font-semibold text-gray-900 sm:text-2xl dark:text-white"
              data-i18n="common.analytics.summary"
            >
              {t('common.analytics.summary')}
            </h1>
          </div>
          <div class="sm:flex">
            <div
              class="items-center hidden mb-3 sm:flex sm:divide-x sm:divide-gray-100 sm:mb-0 dark:divide-gray-700"
            >
                <div data-filters></div>

            </div>
          </div>
      </div>
    </div>
    <div class="p-4
			bg-white
			border-b
			border-gray-200
			dark:bg-gray-800">

        <div
          class="
            flex
            flex-col
          "
        >
          <!-- KPI CARDS -->
          <section
            data-cards
            class="
              shrink-0
              flex
              gap-4
              pb-4
            "
          ></section>

          <!-- MAIN ANALYTICS WORKSPACE -->
          <section
            data-analytics-workspace
            class="
              grid
              grid-cols-1
              xl:grid-cols-12
              gap-4
              px-4
              pb-4
            "
          >

            <div
              data-table-panel-1
              class="
                xl:col-span-7
              "
            >
              <div data-table class="pr-1"></div>

              <!--<div data-line-chart class="col-span-12 xl:col-span-8"></div>

              <div data-table class="mt-4"></div>

              <div data-bar-chart class="mt-4"></div>

              <div data-pie-chart class="col-span-12 xl:col-span-4"></div>-->

              <!-- FUTURE -->

              <!--
              <div data-activity-feed></div>

              <div data-insights></div>

              <div data-smart-chat></div>
              -->
            </div>

            <div
              data-charts-panel
              class="
                xl:col-span-5
              "
            >
              <div
                  data-charts
                  class="
                  pr-1
                  xl:max-h-[calc(100vh-12rem)]
                  xl:overflow-y-auto
                  "
              ></div>
            </div>
          </section>
        </div>

    </div>

</analytics-dashboard>

<script type="module">

  import {
    mountCustomersAnalytics
  }
  from
  '/src/modules/customers/customers.analytics.ui.ts';

  const el =
    document.getElementById(
      'customers-analytics-root'
    );

  if (el) {console.log('dashboard root', el);
    mountCustomersAnalytics(el);
  }

</script>
