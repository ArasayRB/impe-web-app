---
interface AutomationItem {
  title: string;
  description: string;
}

interface Props {
  content: {
    eyebrow: string;
    title: string;
    description: string;
    image: string;
    image_alt: string;
    items_title: string;
    items: AutomationItem[];
    trial_title: string;
    trial_description: string;
    trial_emphasis: string;
  };
}

const { content } = Astro.props;
---

<section class="automation-section" id="automatizacion">
  <div class="automation-section__container">
    <header class="automation-section__header">
      <span class="automation-section__eyebrow">{content.eyebrow}</span>
      <h2>{content.title}</h2>
      <p>{content.description}</p>
    </header>

    <div class="automation-section__visual">
      <img
        src={content.image}
        alt={content.image_alt}
        loading="lazy"
        decoding="async"
      />
    </div>

    <div class="automation-section__capabilities">
      <h3>{content.items_title}</h3>

      <div class="automation-section__grid">
        {content.items.map((item, index) => (
          <article class="automation-section__card">
            <span class="automation-section__number">
              {String(index + 1).padStart(2, '0')}
            </span>
            <h4>{item.title}</h4>
            <p>{item.description}</p>
          </article>
        ))}
      </div>
    </div>

    <aside class="automation-section__trial">
      <div class="automation-section__trial-content">
        <span class="automation-section__trial-label">
          {content.trial_title}
        </span>
        <p>{content.trial_description}</p>
        <strong>{content.trial_emphasis}</strong>
      </div>
      <div class="automation-section__trial-duration" aria-label="30 días">
        <span>30</span>
        <span>días</span>
      </div>
    </aside>
  </div>
</section>

<style>
  .automation-section {
    padding: clamp(4rem, 8vw, 7rem) 1.25rem;
    background: #f7f9fc;
    color: #172b4d;
  }

  .automation-section__container {
    width: min(100%, 1160px);
    margin-inline: auto;
  }

  .automation-section__header {
    max-width: 800px;
    margin: 0 auto 2.5rem;
    text-align: center;
  }

  .automation-section__eyebrow {
    display: inline-block;
    margin-bottom: 1rem;
    color: #0057b7;
    font-size: 0.8rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .automation-section__header h2 {
    margin: 0 0 1.25rem;
    font-size: clamp(2rem, 4.5vw, 3.25rem);
    line-height: 1.12;
    letter-spacing: -0.035em;
  }

  .automation-section__header p {
    max-width: 720px;
    margin: 0 auto;
    color: #52627a;
    font-size: clamp(1rem, 1.7vw, 1.15rem);
    line-height: 1.8;
  }

  .automation-section__visual {
    max-width: 1000px;
    margin: 0 auto 3.5rem;
		aspect-ratio: 915 / 768;
    overflow: hidden;
    border: 1px solid #e1e8f0;
    border-radius: 1.5rem;
    background: #fff;
    box-shadow: 0 18px 50px rgb(23 43 77 / 8%);
  }

  .automation-section__visual img {
    display: block;
    width: 100%;
    height: auto;
  }

  .automation-section__capabilities {
    margin-bottom: 3rem;
  }

  .automation-section__capabilities > h3 {
    margin: 0 0 1.5rem;
    text-align: center;
    font-size: clamp(1.4rem, 3vw, 2rem);
  }

  .automation-section__grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1.25rem;
  }

  .automation-section__card {
    padding: 1.5rem;
    border: 1px solid #e1e8f0;
    border-radius: 1rem;
    background: #fff;
    transition: transform 180ms ease, box-shadow 180ms ease;
  }

  .automation-section__card:hover {
    transform: translateY(-3px);
    box-shadow: 0 12px 28px rgb(23 43 77 / 8%);
  }

  .automation-section__number {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.5rem;
    height: 2.5rem;
    margin-bottom: 1.25rem;
    border: 1px solid rgb(0 87 183 / 25%);
    border-radius: 0.75rem;
    background: rgb(0 87 183 / 6%);
    color: #0057b7;
    font-size: 0.8rem;
    font-weight: 800;
  }

  .automation-section__card:nth-child(2) .automation-section__number {
    border-color: rgb(0 168 107 / 30%);
    background: rgb(0 168 107 / 7%);
    color: #00875a;
  }

  .automation-section__card:nth-child(3) .automation-section__number {
    border-color: rgb(255 215 0 / 60%);
    background: rgb(255 215 0 / 14%);
    color: #806600;
  }

  .automation-section__card h4 {
    margin: 0 0 0.75rem;
    font-size: 1.1rem;
    line-height: 1.35;
  }

  .automation-section__card p {
    margin: 0;
    color: #52627a;
    font-size: 0.95rem;
    line-height: 1.7;
  }

  .automation-section__trial {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    padding: clamp(1.5rem, 4vw, 2.5rem);
    border: 1px solid rgb(0 87 183 / 18%);
    border-radius: 1.25rem;
    background: #fff;
    box-shadow: 0 12px 32px rgb(23 43 77 / 5%);
  }

  .automation-section__trial-content {
    max-width: 780px;
  }

  .automation-section__trial-label {
    display: block;
    margin-bottom: 0.75rem;
    color: #0057b7;
    font-size: clamp(1.2rem, 2.5vw, 1.65rem);
    font-weight: 800;
    line-height: 1.3;
  }

  .automation-section__trial-content p {
    margin: 0 0 0.75rem;
    color: #52627a;
    line-height: 1.75;
  }

  .automation-section__trial-content strong {
    display: block;
    color: #172b4d;
    line-height: 1.6;
  }

  .automation-section__trial-duration {
    display: flex;
    flex: 0 0 auto;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    width: 112px;
    height: 112px;
    border: 2px solid #ffd700;
    border-radius: 50%;
    background: #fffdf0;
    color: #172b4d;
  }

  .automation-section__trial-duration span:first-child {
    font-size: 2.5rem;
    font-weight: 800;
    line-height: 1;
  }

  .automation-section__trial-duration span:last-child {
    margin-top: 0.35rem;
    font-size: 0.9rem;
    font-weight: 700;
  }

  @media (max-width: 900px) {
    .automation-section__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 560px) {
    .automation-section__grid {
      grid-template-columns: 1fr;
    }

    .automation-section__card {
      padding: 1.25rem;
    }

    .automation-section__trial {
      align-items: flex-start;
      gap: 1.25rem;
    }

    .automation-section__trial-duration {
      width: 82px;
      height: 82px;
    }

    .automation-section__trial-duration span:first-child {
      font-size: 1.9rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .automation-section__card {
      transition: none;
    }

    .automation-section__card:hover {
      transform: none;
    }
  }
</style>
