
---
interface AutomationItem {
  title: string;
  description: string;
}

interface Props {
  content: {
    eyebrow: string;
    title: string;
    description: string;
    image?: string | null;
    image_alt?: string;
    items_title: string;
    items: AutomationItem[];
    trial_title: string;
    trial_description: string;
    trial_emphasis: string;
  };
}

const { content } = Astro.props;
---

<section class="automation-section" id="automatizacion">
  <div class="automation-section__container">

    <header class="automation-section__header">
      <span class="automation-section__eyebrow">{content.eyebrow}</span>
      <h2>{content.title}</h2>
      <p>{content.description}</p>
    </header>

    <!-- Gráfico vectorial de flujo automatizado -->
    <div class="automation-section__visual" aria-hidden="true">
      <div class="automation-visual__glow"></div>

      <svg class="automation-visual__connections" viewBox="0 0 900 430" fill="none">
        <defs>
          <linearGradient id="automation-flow-gradient" x1="120" y1="200" x2="780" y2="200" gradientUnits="userSpaceOnUse">
            <stop stop-color="#0057B7"/>
            <stop offset=".55" stop-color="#00A86B"/>
            <stop offset="1" stop-color="#0057B7"/>
          </linearGradient>
        </defs>

        <path d="M145 215H755" stroke="url(#automation-flow-gradient)" stroke-width="3" stroke-linecap="round" stroke-dasharray="8 9"/>
        <path d="M300 215V115H450V215M450 215V315H600V215" stroke="#0057B7" stroke-opacity=".3" stroke-width="2" stroke-dasharray="5 7"/>
        <circle cx="300" cy="115" r="5" fill="#FFD700"/>
        <circle cx="600" cy="315" r="5" fill="#00A86B"/>
        <circle cx="145" cy="215" r="7" fill="#0057B7"/>
        <circle cx="755" cy="215" r="7" fill="#00A86B"/>
      </svg>

      <!-- Nodo de entrada -->
      <div class="automation-visual__node automation-visual__node--input">
        <svg viewBox="0 0 24 24" fill="none">
          <path d="M6 3.75h8l4 4V20.25H6V3.75Z" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"/>
          <path d="M14 3.75v4h4M9 12h6M9 15.5h6" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/>
        </svg>
      </div>

      <!-- Nodo de procesamiento -->
      <div class="automation-visual__node automation-visual__node--process">
        <svg viewBox="0 0 48 48" fill="none">
          <circle cx="24" cy="24" r="17" stroke="currentColor" stroke-width="2"/>
          <circle cx="24" cy="24" r="8" stroke="#00A86B" stroke-width="2"/>
          <path d="M24 2v8M24 38v8M2 24h8M38 24h8" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
          <circle cx="24" cy="24" r="3" fill="#FFD700"/>
        </svg>
      </div>

      <!-- Nodo de seguimiento -->
      <div class="automation-visual__node automation-visual__node--follow-up">
        <svg viewBox="0 0 24 24" fill="none">
          <rect x="4" y="3.5" width="16" height="17" rx="2.5" stroke="currentColor" stroke-width="1.7"/>
          <path d="m7.5 9 1.5 1.5 2.5-2.5M13.5 9h3M7.5 15l1.5 1.5 2.5-2.5M13.5 15h3" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </div>

      <!-- Nodo de salida -->
      <div class="automation-visual__node automation-visual__node--output">
        <svg viewBox="0 0 24 24" fill="none">
          <path d="m5 12.5 4.2 4.2L19 7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
          <circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="1.5"/>
        </svg>
      </div>

      <!-- Indicadores visuales secundarios -->
      <span class="automation-visual__particle automation-visual__particle--one"></span>
      <span class="automation-visual__particle automation-visual__particle--two"></span>
      <span class="automation-visual__particle automation-visual__particle--three"></span>
      <span class="automation-visual__particle automation-visual__particle--four"></span>
    </div>

    <div class="automation-section__capabilities">
      <h3>{content.items_title}</h3>

      <div class="automation-section__grid">
        {content.items.map((item, index) => (
          <article class="automation-section__card">
            <span class="automation-section__number">
              {String(index + 1).padStart(2, '0')}
            </span>
            <h4>{item.title}</h4>
            <p>{item.description}</p>
          </article>
        ))}
      </div>
    </div>

    <aside class="automation-section__trial">
      <div class="automation-section__trial-content">
        <span class="automation-section__trial-label">
          {content.trial_title}
        </span>
        <p>{content.trial_description}</p>
        <strong>{content.trial_emphasis}</strong>
      </div>

      <div class="automation-section__trial-duration" aria-hidden="true">
        <svg class="automation-section__duration-ring" viewBox="0 0 120 120" fill="none">
          <circle cx="60" cy="60" r="49" stroke="#FFD700" stroke-opacity=".3" stroke-width="3"/>
          <circle cx="60" cy="60" r="49" stroke="#0057B7" stroke-width="3" stroke-linecap="round" stroke-dasharray="230 78" transform="rotate(-90 60 60)"/>
        </svg>
        <span>30</span>
      </div>
    </aside>

  </div>
</section>

<style>
  .automation-section {
    padding: clamp(4rem, 8vw, 7rem) 1.25rem;
    background: #f7f9fc;
    color: #172b4d;
  }

  :global(.dark) .automation-section {
    background: #030712;
    color: #f9fafb;
  }

  .automation-section__container {
    width: min(100%, 1160px);
    margin-inline: auto;
  }

  .automation-section__header {
    max-width: 800px;
    margin: 0 auto 2.5rem;
    text-align: center;
  }

  .automation-section__eyebrow {
    display: inline-block;
    margin-bottom: 1rem;
    color: #0057b7;
    font-size: .8rem;
    font-weight: 800;
    letter-spacing: .12em;
    text-transform: uppercase;
  }

  :global(.dark) .automation-section__eyebrow { color: #FFD700; }

  .automation-section__header h2 {
    margin: 0 0 1.25rem;
    font-size: clamp(2rem, 4.5vw, 3.25rem);
    line-height: 1.12;
    letter-spacing: -.035em;
    font-weight: 750;
  }

  .automation-section__header p {
    max-width: 720px;
    margin: 0 auto;
    color: #52627a;
    font-size: clamp(1rem, 1.7vw, 1.15rem);
    line-height: 1.8;
  }

  :global(.dark) .automation-section__header p { color: #d1d5db; }

  .automation-section__visual {
    position: relative;
    width: 100%;
    max-width: 1000px;
    min-height: 360px;
    margin: 0 auto 3.5rem;
    overflow: hidden;
    border: 1px solid #e1e8f0;
    border-radius: 1.5rem;
    background: white;
    box-shadow: 0 18px 50px rgb(23 43 77 / 8%);
    isolation: isolate;
  }

  :global(.dark) .automation-section__visual {
    border-color: #374151;
    background: #111827;
    box-shadow: 0 18px 50px rgb(0 0 0 / 24%);
  }

  .automation-visual__glow {
    position: absolute;
    inset: 10%;
    z-index: -1;
    border-radius: 50%;
    background: radial-gradient(ellipse, rgb(0 87 183 / 10%), rgb(0 168 107 / 7%) 50%, transparent 75%);
    filter: blur(18px);
  }

  .automation-visual__connections {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: -1;
  }

  .automation-visual__node {
    position: absolute;
    top: 50%;
    display: grid;
    width: 74px;
    height: 74px;
    place-items: center;
    border: 1px solid rgb(148 163 184 / 25%);
    border-radius: 21px;
    background: white;
    box-shadow: 0 16px 40px rgb(23 43 77 / 10%);
    transform: translate(-50%, -50%);
  }

  :global(.dark) .automation-visual__node {
    border-color: #374151;
    background: #1f2937;
    box-shadow: 0 16px 40px rgb(0 0 0 / 25%);
  }

  .automation-visual__node svg { width: 31px; height: 31px; }
  .automation-visual__node--input { left: 16%; color: #0057B7; }
  .automation-visual__node--process {
    left: 39%;
    width: 102px;
    height: 102px;
    border-radius: 50%;
    border-color: rgb(0 87 183 / 20%);
    color: #0057B7;
  }
  .automation-visual__node--process svg { width: 57px; height: 57px; }
  .automation-visual__node--follow-up { left: 62%; color: #00875a; }
  .automation-visual__node--output { left: 84%; color: #0057B7; }

  .automation-visual__particle {
    position: absolute;
    width: 9px;
    height: 9px;
    border-radius: 50%;
    box-shadow: 0 0 0 5px rgb(0 87 183 / 8%);
  }

  .automation-visual__particle--one { top: 23%; left: 27%; background: #FFD700; }
  .automation-visual__particle--two { right: 27%; bottom: 23%; background: #00A86B; }
  .automation-visual__particle--three { bottom: 23%; left: 28%; background: #0057B7; }
  .automation-visual__particle--four { top: 23%; right: 28%; background: #FFD700; }

  .automation-section__capabilities { margin-bottom: 3rem; }

  .automation-section__capabilities > h3 {
    margin: 0 0 1.5rem;
    text-align: center;
    font-size: clamp(1.4rem, 3vw, 2rem);
    font-weight: 750;
  }

  .automation-section__grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1.25rem;
  }

  .automation-section__card {
    padding: 1.5rem;
    border: 1px solid #e1e8f0;
    border-radius: 1rem;
    background: white;
    transition: transform 180ms ease, box-shadow 180ms ease;
  }

  :global(.dark) .automation-section__card {
    border-color: #374151;
    background: #111827;
  }

  .automation-section__card:hover {
    transform: translateY(-3px);
    box-shadow: 0 12px 28px rgb(23 43 77 / 8%);
  }

  .automation-section__number {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.5rem;
    height: 2.5rem;
    margin-bottom: 1.25rem;
    border: 1px solid rgb(0 87 183 / 25%);
    border-radius: .75rem;
    background: rgb(0 87 183 / 6%);
    color: #0057b7;
    font-size: .8rem;
    font-weight: 800;
  }

  .automation-section__card:nth-child(2) .automation-section__number {
    border-color: rgb(0 168 107 / 30%);
    background: rgb(0 168 107 / 7%);
    color: #00875a;
  }

  .automation-section__card:nth-child(3) .automation-section__number {
    border-color: rgb(255 215 0 / 60%);
    background: rgb(255 215 0 / 14%);
    color: #806600;
  }

  .automation-section__card h4 {
    margin: 0 0 .75rem;
    font-size: 1.1rem;
    line-height: 1.35;
    font-weight: 700;
  }

  .automation-section__card p {
    margin: 0;
    color: #52627a;
    font-size: .95rem;
    line-height: 1.7;
  }

  :global(.dark) .automation-section__card p { color: #d1d5db; }

  .automation-section__trial {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    padding: clamp(1.5rem, 4vw, 2.5rem);
    border: 1px solid rgb(0 87 183 / 18%);
    border-radius: 1.25rem;
    background: white;
    box-shadow: 0 12px 32px rgb(23 43 77 / 5%);
  }

  :global(.dark) .automation-section__trial {
    border-color: #374151;
    background: #111827;
    box-shadow: 0 12px 32px rgb(0 0 0 / 20%);
  }

  .automation-section__trial-content { max-width: 780px; }

  .automation-section__trial-label {
    display: block;
    margin-bottom: .75rem;
    color: #0057b7;
    font-size: clamp(1.2rem, 2.5vw, 1.65rem);
    font-weight: 800;
    line-height: 1.3;
  }

  :global(.dark) .automation-section__trial-label { color: #FFD700; }

  .automation-section__trial-content p {
    margin: 0 0 .75rem;
    color: #52627a;
    line-height: 1.75;
  }

  :global(.dark) .automation-section__trial-content p { color: #d1d5db; }

  .automation-section__trial-content strong {
    display: block;
    color: #172b4d;
    line-height: 1.6;
  }

  :global(.dark) .automation-section__trial-content strong { color: #f9fafb; }

  .automation-section__trial-duration {
    position: relative;
    display: grid;
    flex: 0 0 auto;
    width: 112px;
    height: 112px;
    place-items: center;
    border-radius: 50%;
    background: #fffdf0;
    color: #172b4d;
  }

  :global(.dark) .automation-section__trial-duration {
    background: #292719;
    color: #f9fafb;
  }

  .automation-section__duration-ring {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .automation-section__trial-duration > span {
    font-size: 2.5rem;
    font-weight: 800;
    line-height: 1;
  }

  @media (max-width: 900px) {
    .automation-section__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }

  @media (max-width: 560px) {
    .automation-section__visual { min-height: 270px; }
    .automation-visual__node { width: 53px; height: 53px; border-radius: 15px; }
    .automation-visual__node svg { width: 24px; height: 24px; }
    .automation-visual__node--process { width: 76px; height: 76px; border-radius: 50%; }
    .automation-visual__node--process svg { width: 44px; height: 44px; }
    .automation-section__grid { grid-template-columns: 1fr; }
    .automation-section__card { padding: 1.25rem; }
    .automation-section__trial { align-items: flex-start; gap: 1.25rem; }
    .automation-section__trial-duration { width: 82px; height: 82px; }
    .automation-section__trial-duration > span { font-size: 1.9rem; }
  }

  @media (prefers-reduced-motion: reduce) {
    .automation-section__card { transition: none; }
    .automation-section__card:hover { transform: none; }
  }
</style>
