
---
interface FollowUpItem {
  title: string;
  description: string;
}

interface Props {
  content: {
    eyebrow: string;
    title: string;
    description: string;
    emphasis: string;
    items: FollowUpItem[];
    image?: string | null;
    team_title: string;
    team_description: string;
  };
}

const { content } = Astro.props;
---

<section class="calendar-follow-up bg-white px-4 py-16 text-gray-900 dark:bg-gray-950 dark:text-white sm:px-6 sm:py-20 lg:px-8 lg:py-24">
  <div class="mx-auto grid max-w-7xl items-center gap-12 lg:grid-cols-2 lg:gap-16">

    <!-- Gráfico vectorial de calendario y seguimiento -->
    <div class="calendar-follow-up__visual" aria-hidden="true">
      <div class="calendar-follow-up__visual-glow"></div>

      <div class="calendar-graphic">
        <div class="calendar-graphic__top">
          <span></span><span></span><span></span>
        </div>

        <div class="calendar-graphic__body">
          <div class="calendar-graphic__grid">
            {Array.from({ length: 35 }, (_, index) => (
              <span class:list={[
                'calendar-graphic__cell',
                index === 8 && 'calendar-graphic__cell--blue',
                index === 12 && 'calendar-graphic__cell--gold',
                index === 17 && 'calendar-graphic__cell--green',
                index === 23 && 'calendar-graphic__cell--blue-soft',
                index === 27 && 'calendar-graphic__cell--green-soft',
              ]}>
                {[
                  8, 12, 17, 23, 27
                ].includes(index) && <i></i>}
              </span>
            ))}
          </div>

          <div class="calendar-graphic__event calendar-graphic__event--one">
            <span></span><i></i><i></i>
          </div>
          <div class="calendar-graphic__event calendar-graphic__event--two">
            <span></span><i></i><i></i>
          </div>
        </div>
      </div>

      <!-- Nodos conectados al calendario -->
      <svg class="calendar-follow-up__connections" viewBox="0 0 520 460" fill="none">
        <path d="M260 210 L105 95 M260 210 L420 115 M260 210 L100 355 M260 210 L420 355" stroke="#0057B7" stroke-opacity=".5" stroke-width="2" stroke-dasharray="5 7"/>
        <circle cx="105" cy="95" r="5" fill="#FFD700"/>
        <circle cx="420" cy="115" r="5" fill="#0057B7"/>
        <circle cx="100" cy="355" r="5" fill="#00A86B"/>
        <circle cx="420" cy="355" r="5" fill="#FFD700"/>
      </svg>

      <div class="calendar-follow-up__node calendar-follow-up__node--document">
        <svg viewBox="0 0 24 24" fill="none">
          <path d="M6 3.75h8l4 4V20.25H6V3.75Z" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"/>
          <path d="M14 3.75v4h4M9 12h6M9 15.5h6" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/>
        </svg>
      </div>

      <div class="calendar-follow-up__node calendar-follow-up__node--people">
        <svg viewBox="0 0 24 24" fill="none">
          <circle cx="9" cy="8" r="3" stroke="currentColor" stroke-width="1.7"/>
          <path d="M3.5 19v-1.5A5.5 5.5 0 0 1 9 12a5.5 5.5 0 0 1 5.5 5.5V19h-11Z" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"/>
          <path d="M15 5.5a3 3 0 0 1 0 5.8M17 13a4.5 4.5 0 0 1 3.5 4.4V19H18" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/>
        </svg>
      </div>

      <div class="calendar-follow-up__node calendar-follow-up__node--tasks">
        <svg viewBox="0 0 24 24" fill="none">
          <rect x="4" y="3.5" width="16" height="17" rx="2.5" stroke="currentColor" stroke-width="1.7"/>
          <path d="m7.5 9 1.5 1.5 2.5-2.5M13.5 9h3M7.5 15l1.5 1.5 2.5-2.5M13.5 15h3" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </div>

      <div class="calendar-follow-up__node calendar-follow-up__node--message">
        <svg viewBox="0 0 24 24" fill="none">
          <path d="M20 11.5a7.5 7.5 0 0 1-7.5 7.5H7l-3.5 2v-5.2A7.5 7.5 0 1 1 20 11.5Z" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"/>
          <path d="M8 10h8M8 13.5h5" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/>
        </svg>
      </div>
    </div>

    <!-- Contenido localizado -->
    <div class="calendar-follow-up__content">
      <header class="calendar-follow-up__header">
        <span class="calendar-follow-up__eyebrow">{content.eyebrow}</span>
        <h2>{content.title}</h2>
        <p>{content.description}</p>
        <p class="calendar-follow-up__emphasis">{content.emphasis}</p>
      </header>

      <div class="calendar-follow-up__items">
        {content.items.map((item, index) => (
          <article class="calendar-follow-up__item">
            <div class="calendar-follow-up__item-marker">
              {index === 0 && (
                <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                  <rect x="3.5" y="5" width="17" height="15.5" rx="2.5" stroke="#0057B7" stroke-width="1.7"/>
                  <path d="M7.5 3.5V7M16.5 3.5V7M3.5 9.5H20.5" stroke="#0057B7" stroke-width="1.7" stroke-linecap="round"/>
                  <path d="M8 13H11M8 16H14" stroke="#00A86B" stroke-width="1.8" stroke-linecap="round"/>
                </svg>
              )}

              {index === 1 && (
                <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                  <rect x="4" y="3.5" width="16" height="17" rx="2.5" stroke="#0057B7" stroke-width="1.7"/>
                  <path d="M8 8.5L9.5 10L12 7.5M14 9H17M8 14L9.5 15.5L12 13M14 14.5H17" stroke="#00A86B" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              )}

              {index === 2 && (
                <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                  <path d="M18 9A6 6 0 0 0 6 9C6 16 3.5 16 3.5 18H20.5C20.5 16 18 16 18 9Z" stroke="#0057B7" stroke-width="1.7" stroke-linejoin="round"/>
                  <path d="M9.5 21H14.5" stroke="#00A86B" stroke-width="2" stroke-linecap="round"/>
                  <circle cx="18" cy="5" r="2.5" fill="#FFD700"/>
                </svg>
              )}

              <span class="calendar-follow-up__number">
                {String(index + 1).padStart(2, '0')}
              </span>
            </div>

            <h3>{item.title}</h3>
            <p>{item.description}</p>
          </article>
        ))}
      </div>

      <div class="calendar-follow-up__team">
        <h3>{content.team_title}</h3>
        <p>{content.team_description}</p>
      </div>
    </div>
  </div>
</section>

<style>
  .calendar-follow-up__visual {
    position: relative;
    width: 100%;
    min-height: 390px;
    aspect-ratio: 1.13;
    isolation: isolate;
  }

  .calendar-follow-up__visual-glow {
    position: absolute;
    inset: 15%;
    z-index: -1;
    border-radius: 50%;
    background: radial-gradient(circle, rgb(0 87 183 / 12%), rgb(0 168 107 / 7%) 52%, transparent 75%);
    filter: blur(15px);
  }

  .calendar-follow-up__connections {
    position: absolute;
    inset: 0;
    z-index: -1;
    width: 100%;
    height: 100%;
  }

  .calendar-graphic {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 61%;
    overflow: hidden;
    border: 1px solid rgb(148 163 184 / 30%);
    border-radius: 18px;
    background: white;
    box-shadow: 0 25px 70px rgb(15 23 42 / 13%);
    transform: translate(-50%, -50%);
  }

  :global(.dark) .calendar-graphic {
    border-color: rgb(148 163 184 / 25%);
    background: #111827;
    box-shadow: 0 25px 70px rgb(0 0 0 / 30%);
  }

  .calendar-graphic__top {
    display: flex;
    gap: 5px;
    align-items: center;
    padding: 13px 14px;
    border-bottom: 1px solid #e5e7eb;
  }

  :global(.dark) .calendar-graphic__top { border-color: #374151; }

  .calendar-graphic__top span {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #cbd5e1;
  }

  .calendar-graphic__top span:first-child { background: #FFD700; }
  .calendar-graphic__top span:nth-child(2) { background: #0057B7; }
  .calendar-graphic__top span:nth-child(3) { background: #00A86B; }

  .calendar-graphic__body { position: relative; padding: 15px; }

  .calendar-graphic__grid {
    display: grid;
    grid-template-columns: repeat(7, minmax(0, 1fr));
    gap: 5px;
  }

  .calendar-graphic__cell {
    display: grid;
    min-width: 0;
    aspect-ratio: 1;
    place-items: center;
    border-radius: 5px;
    background: #f3f6fa;
  }

  :global(.dark) .calendar-graphic__cell { background: #1f2937; }

  .calendar-graphic__cell i {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: currentColor;
  }

  .calendar-graphic__cell--blue { background: #0057B7; color: white; }
  .calendar-graphic__cell--gold { background: #FFD700; color: #735900; }
  .calendar-graphic__cell--green { background: #00A86B; color: white; }
  .calendar-graphic__cell--blue-soft { background: rgb(0 87 183 / 14%); color: #0057B7; }
  .calendar-graphic__cell--green-soft { background: rgb(0 168 107 / 15%); color: #00875a; }

  .calendar-graphic__event {
    display: flex;
    align-items: center;
    gap: 7px;
    margin-top: 11px;
    padding: 9px;
    border-radius: 8px;
    background: #f3f6fa;
  }

  :global(.dark) .calendar-graphic__event { background: #1f2937; }

  .calendar-graphic__event span {
    width: 5px;
    height: 25px;
    flex: 0 0 5px;
    border-radius: 999px;
    background: #0057B7;
  }

  .calendar-graphic__event--two span { background: #00A86B; }

  .calendar-graphic__event i {
    display: block;
    height: 5px;
    border-radius: 999px;
    background: #cbd5e1;
  }

  .calendar-graphic__event i:nth-child(2) { width: 45%; }
  .calendar-graphic__event i:nth-child(3) { width: 20%; opacity: .6; }

  .calendar-follow-up__node {
    position: absolute;
    display: grid;
    width: 57px;
    height: 57px;
    place-items: center;
    border: 1px solid rgb(148 163 184 / 25%);
    border-radius: 17px;
    background: white;
    box-shadow: 0 12px 30px rgb(15 23 42 / 9%);
  }

  .calendar-follow-up__node svg { width: 25px; height: 25px; }
  .calendar-follow-up__node--document { top: 8%; left: 8%; color: #0057B7; }
  .calendar-follow-up__node--people { top: 11%; right: 7%; color: #00875a; }
  .calendar-follow-up__node--tasks { bottom: 8%; left: 8%; color: #0057B7; }
  .calendar-follow-up__node--message { right: 7%; bottom: 8%; color: #8a6500; }

  :global(.dark) .calendar-follow-up__node {
    border-color: rgb(148 163 184 / 22%);
    background: #111827;
  }

  .calendar-follow-up__content { max-width: 100%; }

  .calendar-follow-up__header { margin-bottom: 2rem; }

  .calendar-follow-up__eyebrow {
    display: inline-block;
    margin-bottom: .75rem;
    color: #0057B7;
    font-size: .8rem;
    font-weight: 700;
    letter-spacing: .12em;
    text-transform: uppercase;
  }

  :global(.dark) .calendar-follow-up__eyebrow { color: #FFD700; }

  .calendar-follow-up__header h2 {
    margin: 0 0 1rem;
    font-size: clamp(2rem, 4vw, 3.25rem);
    font-weight: 750;
    line-height: 1.12;
    letter-spacing: -.025em;
  }

  .calendar-follow-up__header p,
  .calendar-follow-up__item p,
  .calendar-follow-up__team p { line-height: 1.7; }

  .calendar-follow-up__header > p:not(.calendar-follow-up__emphasis) {
    color: #4b5563;
  }

  :global(.dark) .calendar-follow-up__header > p:not(.calendar-follow-up__emphasis) { color: #d1d5db; }

  .calendar-follow-up__emphasis { margin-top: 1rem; font-weight: 650; }

  .calendar-follow-up__items {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
  }

  .calendar-follow-up__item {
    padding: 1.25rem;
    border: 1px solid #e5e7eb;
    border-radius: 1rem;
    background: white;
  }

  :global(.dark) .calendar-follow-up__item {
    border-color: #374151;
    background: #111827;
  }

  .calendar-follow-up__item-marker {
    display: flex;
    align-items: center;
    gap: .65rem;
    margin-bottom: 1.1rem;
  }

  .calendar-follow-up__item-marker svg {
    width: 2.5rem;
    height: 2.5rem;
    flex-shrink: 0;
    padding: .5rem;
    border: 1px solid rgb(0 87 183 / 25%);
    border-radius: .75rem;
    background: rgb(0 87 183 / 5%);
  }

  .calendar-follow-up__number {
    color: #0057B7;
    font-size: .8rem;
    font-weight: 700;
    letter-spacing: .04em;
  }

  .calendar-follow-up__item h3,
  .calendar-follow-up__team h3 {
    margin: 0 0 .65rem;
    font-size: 1.05rem;
    font-weight: 700;
  }

  .calendar-follow-up__item p,
  .calendar-follow-up__team p { margin: 0; color: #4b5563; }

  :global(.dark) .calendar-follow-up__item p,
  :global(.dark) .calendar-follow-up__team p { color: #d1d5db; }

  .calendar-follow-up__team {
    margin-top: 1.5rem;
    padding: clamp(1.5rem, 4vw, 2rem);
    border: 1px solid rgb(0 87 183 / 12%);
    border-radius: 1rem;
    background: #f5f7fa;
  }

  :global(.dark) .calendar-follow-up__team {
    border-color: #374151;
    background: #111827;
  }

  @media (max-width: 900px) {
    .calendar-follow-up__visual { max-width: 560px; }
    .calendar-follow-up__items { grid-template-columns: 1fr; }
  }

  @media (max-width: 520px) {
    .calendar-follow-up__visual { min-height: 320px; }
    .calendar-follow-up__node { width: 46px; height: 46px; border-radius: 14px; }
    .calendar-follow-up__node svg { width: 21px; height: 21px; }
    .calendar-graphic { width: 65%; }
    .calendar-graphic__body { padding: 10px; }
    .calendar-graphic__grid { gap: 3px; }
  }
</style>
