
---
interface FollowUpItem {
  title: string;
  description: string;
}

interface Props {
  content: {
    eyebrow: string;
    title: string;
    description: string;
    emphasis: string;
    items: FollowUpItem[];
    image: string;
    team_title: string;
    team_description: string;
  };
}

const { content } = Astro.props;
---

<section class="calendar-follow-up">
  <div class="calendar-follow-up__image">
    <img
      src={content.image}
      alt={content.title}
      loading="lazy"
    />
  </div>

  <div class="calendar-follow-up__content">
    <header class="calendar-follow-up__header">
      <span class="calendar-follow-up__eyebrow">
        {content.eyebrow}
      </span>

      <h2>{content.title}</h2>

      <p>{content.description}</p>

      <p class="calendar-follow-up__emphasis">
        {content.emphasis}
      </p>
    </header>

		<div class="calendar-follow-up__items">
			{content.items.map((item, index) => (
				<article class="calendar-follow-up__item">
					<div class="calendar-follow-up__item-marker">
						{index === 0 && (
							<svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
								<rect x="3.5" y="5" width="17" height="15.5" rx="2.5" stroke="#0057B7" stroke-width="1.7" />
								<path d="M7.5 3.5V7M16.5 3.5V7M3.5 9.5H20.5" stroke="#0057B7" stroke-width="1.7" stroke-linecap="round" />
								<path d="M8 13H11M8 16H14" stroke="#00A86B" stroke-width="1.8" stroke-linecap="round" />
							</svg>
						)}

						{index === 1 && (
							<svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
								<rect x="4" y="3.5" width="16" height="17" rx="2.5" stroke="#0057B7" stroke-width="1.7" />
								<path d="M8 8.5L9.5 10L12 7.5M14 9H17M8 14L9.5 15.5L12 13M14 14.5H17" stroke="#00A86B" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" />
							</svg>
						)}

						{index === 2 && (
							<svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
								<path d="M18 9A6 6 0 0 0 6 9C6 16 3.5 16 3.5 18H20.5C20.5 16 18 16 18 9Z" stroke="#0057B7" stroke-width="1.7" stroke-linejoin="round" />
								<path d="M9.5 21H14.5" stroke="#00A86B" stroke-width="2" stroke-linecap="round" />
								<circle cx="18" cy="5" r="2.5" fill="#FFD700" />
							</svg>
						)}

						<span class="calendar-follow-up__number">
							{String(index + 1).padStart(2, '0')}
						</span>
					</div>

					<h3>{item.title}</h3>
					<p>{item.description}</p>
				</article>
			))}
		</div>

    <div class="calendar-follow-up__team">
      <h3>{content.team_title}</h3>
      <p>{content.team_description}</p>
    </div>
  </div>
</section>

<style>
  .calendar-follow-up {
    width: 100%;
  }

  .calendar-follow-up__image {
    width: 100%;
		aspect-ratio: 933 / 768;
    overflow: hidden;
  }

  .calendar-follow-up__image img {
    display: block;
    width: 100%;
    height: auto;
  }

  .calendar-follow-up__content {
    max-width: 1100px;
    margin-inline: auto;
  }

  .calendar-follow-up__header {
    max-width: 780px;
    margin-bottom: 2.5rem;
  }

  .calendar-follow-up__eyebrow {
    display: inline-block;
    margin-bottom: 0.75rem;
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .calendar-follow-up__header h2 {
    margin: 0 0 1rem;
    font-size: clamp(2rem, 4vw, 3.25rem);
    line-height: 1.12;
  }

  .calendar-follow-up__header p,
  .calendar-follow-up__item p,
  .calendar-follow-up__team p {
    line-height: 1.7;
  }

  .calendar-follow-up__emphasis {
    font-weight: 600;
  }

  .calendar-follow-up__items {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.5rem;
  }

  .calendar-follow-up__item {
    padding: 1.5rem;
    border: 1px solid var(--color-border, #e5e7eb);
    border-radius: 1rem;
  }

  .calendar-follow-up__number {
    display: inline-block;
    margin-bottom: 1.25rem;
    font-size: 0.8rem;
    font-weight: 700;
    opacity: 0.7;
  }

  .calendar-follow-up__item h3,
  .calendar-follow-up__team h3 {
    margin: 0 0 0.75rem;
    font-size: 1.15rem;
  }

  .calendar-follow-up__item p,
  .calendar-follow-up__team p {
    margin: 0;
  }

  .calendar-follow-up__team {
    margin-top: 2rem;
    padding: clamp(1.5rem, 4vw, 2.5rem);
    border-radius: 1rem;
    background: var(--color-surface-secondary, #f5f7fa);
  }

	.calendar-follow-up__item-marker {
  display: flex;
  align-items: center;
  gap: 0.65rem;
  margin-bottom: 1.25rem;
}

.calendar-follow-up__item-marker svg {
  width: 2.5rem;
  height: 2.5rem;
  flex-shrink: 0;
  padding: 0.5rem;
  color: #0057B7;
  border: 1px solid rgb(0 87 183 / 25%);
  border-radius: 0.75rem;
  background: rgb(0 87 183 / 5%);
}

.calendar-follow-up__number {
  margin-bottom: 0;
  color: #0057B7;
  font-size: 0.8rem;
  font-weight: 700;
  letter-spacing: 0.04em;
}

  @media (max-width: 768px) {
    .calendar-follow-up__items {
      grid-template-columns: 1fr;
      gap: 1rem;
    }

    .calendar-follow-up__image img {
      max-height: 360px;
    }
  }
</style>
