
---
interface Props {
  section: {
    key?: string;
    type?: string;
    sort_order?: number;
    content?: {
      eyebrow?: string;
      title?: string;
      description?: string;
      image?: string | null;
      pain_points?: string[];
      conclusion?: string;
    };
  };
}

const { section } = Astro.props;
const content = section.content ?? {};

const painPoints = content.pain_points ?? [];
---

<section
  id={section.key}
  class="relative isolate overflow-hidden bg-gray-50 dark:bg-gray-900"
>
  <div
    class="pointer-events-none absolute -right-40 top-1/2 -z-10 h-96 w-96 -translate-y-1/2 rounded-full bg-[#0057B7]/10 blur-3xl"
    aria-hidden="true"
  ></div>

  <div class="mx-auto max-w-7xl px-6 py-20 sm:py-28 lg:px-8">
    <div class="grid items-center gap-12 lg:grid-cols-2 lg:gap-20">

      <!-- Visual: información dispersa -->
      {content.image && (
        <div class="relative">
          <div class="overflow-hidden rounded-3xl border border-gray-200 bg-white p-3 shadow-xl shadow-gray-900/5 dark:border-gray-700 dark:bg-gray-950 sm:p-5">
            <img
              src={content.image}
              alt="Información de un caso distribuida entre documentos, mensajes, correo y calendario"
              class="h-auto w-full rounded-2xl object-contain"
              loading="lazy"
              decoding="async"
            />
          </div>
        </div>
      )}

      <!-- Content -->
      <div class="max-w-2xl">
        {content.eyebrow && (
          <p class="mb-4 text-sm font-bold uppercase tracking-[0.16em] text-[#0057B7]">
            {content.eyebrow}
          </p>
        )}

        {content.title && (
          <h2 class="text-3xl font-bold tracking-tight text-gray-950 sm:text-4xl lg:text-5xl dark:text-white">
            {content.title}
          </h2>
        )}

        {content.description && (
          <p class="mt-6 text-lg leading-8 text-gray-600 dark:text-gray-300">
            {content.description}
          </p>
        )}

        {painPoints.length > 0 && (
          <ul class="mt-7 space-y-4">
            {painPoints.map((point) => (
              <li class="flex items-start gap-3 text-base leading-7 text-gray-700 dark:text-gray-300">
                <span
                  class="mt-2 h-2 w-2 shrink-0 rounded-full bg-[#FFD700] ring-2 ring-[#FFD700]/20"
                  aria-hidden="true"
                ></span>
                <span>{point}</span>
              </li>
            ))}
          </ul>
        )}

        {content.conclusion && (
          <p class="mt-8 border-l-4 border-[#00A86B] pl-4 text-lg font-semibold leading-8 text-gray-950 dark:text-white">
            {content.conclusion}
          </p>
        )}
      </div>
    </div>
  </div>
</section>
