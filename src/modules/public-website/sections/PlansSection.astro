---
interface PlanServiceTranslation {
locale: string;
name?: string;
description?: string | null;
}

interface PlanService {
key: string;
name: string;
description?: string | null;
translations?: PlanServiceTranslation[];
}

interface PlanTranslation {
locale: string;
name?: string;
description?: string | null;
}

interface PlanCta {
label: string;
type: string;
action?: {
type?: string;
target?: string;
context?: Record<string, unknown>;
};
}

interface Plan {
key: string;
name: string;
description?: string | null;
price: number | string;
currency: string;
translations?: PlanTranslation[];
services?: PlanService[];
cta?: PlanCta;
}

interface Props {
plans: Plan[];
locale: string;
}

const {
plans,
locale
} = Astro.props;
---

<section id="plans" class="py-16 sm:py-20">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">

<div class="mx-auto mb-12 max-w-3xl text-center">
  <div
    class="mb-6 flex items-center justify-center gap-3"
    aria-hidden="true"
  >
    <span class="h-px w-10 bg-gray-950 dark:bg-white"></span>

    <span class="h-1.5 w-1.5 rounded-full bg-gray-950 dark:bg-white"></span>

    <span class="h-px w-10 bg-gray-950 dark:bg-white"></span>
  </div>

  <h2 class="text-3xl font-bold tracking-tight sm:text-4xl">
    Planes
  </h2>

  <p class="mt-4 text-lg text-gray-600">
    Elige el plan que mejor se adapte a las necesidades de tu negocio.
  </p>
</div>

<div
  class="grid grid-cols-1 gap-8 md:grid-cols-2 lg:grid-cols-3"
>
  {
    plans.map((plan) => {
      const planTranslation =
        plan.translations?.find(
          (translation) =>
            translation.locale === locale
        );

      const planName =
        planTranslation?.name
        ?? plan.name;

      const planDescription =
        planTranslation?.description
        ?? plan.description;

      return (
        <article
          class="flex flex-col rounded-lg border border-gray-200 bg-white p-6 shadow-sm"
        >

          <div>

            <h3 class="text-2xl font-semibold">
              {planName}
            </h3>

            {
              planDescription && (
                <p class="mt-2 text-sm text-gray-500">
                  {planDescription}
                </p>
              )
            }

            <div class="mt-4 flex items-baseline gap-2">

              <span class="text-4xl font-bold">
                {plan.price}
              </span>

              <span class="text-sm text-gray-500">
                {plan.currency}
              </span>

            </div>

          </div>

          {
            plan.services &&
            plan.services.length > 0 && (
              <ul class="mt-8 space-y-3">

                {
                  plan.services.map((service) => {
                    const serviceTranslation =
                      service.translations?.find(
                        (translation) =>
                          translation.locale === locale
                      );

                    const serviceName =
                      serviceTranslation?.name
                      ?? service.name;

                    const serviceDescription =
                      serviceTranslation?.description
                      ?? service.description;

                    return (
                      <li class="flex gap-3">

                        <span
                          aria-hidden="true"
                          class="mt-1"
                        >
                          ✓
                        </span>

                        <div>

                          <p class="font-medium">
                            {serviceName}
                          </p>

                          {
                            serviceDescription && (
                              <p class="mt-1 text-sm text-gray-500">
                                {serviceDescription}
                              </p>
                            )
                          }

                        </div>

                      </li>
                    );
                  })
                }

              </ul>
            )
          }

          {
            plan.cta && (
              <div class="mt-8">

                <a
									href={
										plan.cta.action?.target ??
										'#contact'
									}
									data-plan={plan.key}
									data-plan-context={
										JSON.stringify(
											plan.cta.action?.context ?? {}
										)
									}
									class="inline-flex w-full items-center justify-center rounded-lg px-5 py-3 text-center text-sm font-medium"
								>
									{plan.cta.label}
								</a>

              </div>
            )
          }

        </article>
      );
    })
  }
</div>

  </div>
</section>
