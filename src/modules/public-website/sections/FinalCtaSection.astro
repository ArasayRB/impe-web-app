
---
interface CtaAction {
  label: string;
  type: 'modal' | 'link';
  url: string;
}

interface Props {
  content: {
    eyebrow?: string;
    title: string;
    description: string;
    emphasis?: string;
    reassurance?: string;
    actions?: CtaAction[];
  };
}

const { content,section } = Astro.props;

const actions = content.actions ?? [];
const primaryAction =
actions[0];

const secondaryAction =
actions[1];
---

<section id={section?.key || 'final_cta'} class="final-cta" aria-labelledby="final-cta-title">
  <div class="final-cta__container">
    {content.eyebrow && (
      <p class="final-cta__eyebrow">{content.eyebrow}</p>
    )}

    <h2 id="final-cta-title" class="final-cta__title">
      {content.title}
    </h2>

    <p class="final-cta__description">
      {content.description}
    </p>

    {content.emphasis && (
      <p class="final-cta__emphasis">{content.emphasis}</p>
    )}

    {content.reassurance && (
      <p class="final-cta__reassurance">{content.reassurance}</p>
    )}

    {
    actions.length > 0 && (
      <div
        class="final-cta__actions"
      >

        {
					primaryAction?.url && (
						primaryAction.type === 'modal' ? (
							<button
								type="button"
								data-registration-trigger
								class="final-cta__button"
							>
								{primaryAction.label}
								<svg
									class="h-4 w-4 transition-transform group-hover:translate-x-1"
									fill="none"
									viewBox="0 0 24 24"
									stroke="currentColor"
									stroke-width="2"
									aria-hidden="true"
								>
									<path
										stroke-linecap="round"
										stroke-linejoin="round"
										d="M5 12h14m-7-7 7 7-7 7"
									/>
								</svg>
							</button>
						) : (
							<a
								href={primaryAction.url}
								class="group inline-flex min-h-12 items-center justify-center gap-2 rounded-full bg-[#0057B7] px-7 py-3.5 text-sm font-semibold text-white shadow-lg transition hover:-translate-y-0.5 hover:bg-[#00479A] focus:outline-none focus:ring-2 focus:ring-[#0057B7] focus:ring-offset-2"
							>
								{primaryAction.label}
							</a>
						)
					)
				}


        {
          secondaryAction?.url && (
            <a
              href={secondaryAction.url}
              class="inline-flex items-center justify-center rounded-full px-6 py-3.5 text-sm font-semibold text-gray-700 transition-colors hover:text-gray-950 dark:text-gray-300 dark:hover:text-white"
            >
              {secondaryAction.label}
            </a>
          )
        }

      </div>
    )
  }
  </div>
</section>

<style>
  .final-cta {
    padding: 5rem 1.5rem;
    color: #fff;
    background: #0057b7;
    text-align: center;
  }

  .final-cta__container {
    width: 100%;
    max-width: 900px;
    margin: 0 auto;
  }

  .final-cta__eyebrow {
    margin: 0 0 1rem;
    color: #ffd700;
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.14em;
  }

  .final-cta__title {
    max-width: 760px;
    margin: 0 auto 1.25rem;
    color: #fff;
    font-size: clamp(2rem, 5vw, 3.5rem);
    font-weight: 800;
    line-height: 1.12;
  }

  .final-cta__description {
    max-width: 720px;
    margin: 0 auto 1.5rem;
    color: rgba(255, 255, 255, 0.9);
    font-size: 1.05rem;
    line-height: 1.8;
  }

  .final-cta__emphasis {
    margin: 0 0 0.5rem;
    color: #ffd700;
    font-size: 1.25rem;
    font-weight: 700;
  }

  .final-cta__reassurance {
    margin: 0 0 2rem;
    color: rgba(255, 255, 255, 0.85);
    font-size: 0.95rem;
  }

  .final-cta__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 1rem;
  }

  .final-cta__button {
    display: inline-flex;
    min-width: 240px;
    min-height: 52px;
    align-items: center;
    justify-content: center;
    padding: 0.9rem 1.75rem;
    border: 2px solid #ffd700;
    border-radius: 0.65rem;
    background: #ffd700;
    color: #12304a;
    font-size: 1rem;
    font-weight: 700;
    text-align: center;
    text-decoration: none;
    transition:
      background-color 0.2s ease,
      border-color 0.2s ease,
      transform 0.2s ease;
  }

  .final-cta__button:hover {
    border-color: #ffe766;
    background: #ffe766;
    transform: translateY(-2px);
  }

  .final-cta__button:focus-visible {
    outline: 3px solid #fff;
    outline-offset: 4px;
  }

  @media (max-width: 640px) {
    .final-cta {
      padding: 3.5rem 1.25rem;
    }

    .final-cta__button {
      width: 100%;
      min-width: 0;
    }
  }
</style>
