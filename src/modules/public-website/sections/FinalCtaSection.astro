
---

interface CtaAction {
  label: string;
  type: "modal" | "link";
  url: string;
}

interface Props {
  content: {
    eyebrow?: string;
    title: string;
    description: string;
    emphasis?: string;
    reassurance?: string;
    actions?: CtaAction[];
  };
  section?: {
    key?: string;
  };
}

const { content, section } = Astro.props;
const actions = content.actions ?? [];
const primaryAction = actions[0];
const secondaryAction = actions[1];
---

<section
  id={section?.key || "final_cta"}
  class="final-cta"
  aria-labelledby="final-cta-title"
>
  <div class="final-cta__container">
    {content.eyebrow && (
      <p class="final-cta__eyebrow">{content.eyebrow}</p>
    )}

    <h2 id="final-cta-title">{content.title}</h2>

    <p class="final-cta__description">{content.description}</p>

    {content.emphasis && (
      <p class="final-cta__emphasis">{content.emphasis}</p>
    )}

    <div class="final-cta__actions">
      {primaryAction && (
        primaryAction.type === "modal" ? (
          <button
            type="button"
            data-registration-trigger
            class="final-cta__button final-cta__button--primary"
          >
            {primaryAction.label}
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path d="M5 12h14M13 6l6 6-6 6" />
            </svg>
          </button>
        ) : (
          <a
            href={primaryAction.url}
            class="final-cta__button final-cta__button--primary"
          >
            {primaryAction.label}
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path d="M5 12h14M13 6l6 6-6 6" />
            </svg>
          </a>
        )
      )}

      {secondaryAction && (
        <a
          href={secondaryAction.url}
          class="final-cta__secondary"
        >
          {secondaryAction.label}
        </a>
      )}
    </div>

    {content.reassurance && (
      <p class="final-cta__reassurance">{content.reassurance}</p>
    )}

    <div class="final-cta__decoration" aria-hidden="true">
      <span class="final-cta__decoration-dot final-cta__decoration-dot--one"></span>
      <span class="final-cta__decoration-dot final-cta__decoration-dot--two"></span>
      <span class="final-cta__decoration-dot final-cta__decoration-dot--three"></span>
    </div>
  </div>
</section>

<style>
  .final-cta {
    position: relative;
    overflow: hidden;
    background: #0057b7;
    color: #ffffff;
    padding: clamp(4.5rem, 9vw, 7.5rem) 1.5rem;
    isolation: isolate;
  }

  .final-cta__container {
    position: relative;
    z-index: 1;
    max-width: 850px;
    margin-inline: auto;
    text-align: center;
  }

  .final-cta__eyebrow {
    color: #ffd700;
    font-size: 0.8rem;
    font-weight: 800;
    letter-spacing: 0.13em;
    text-transform: uppercase;
    margin-bottom: 1.25rem;
  }

  .final-cta h2 {
    font-size: clamp(2.2rem, 5vw, 3.8rem);
    line-height: 1.08;
    letter-spacing: -0.04em;
    margin: 0 auto 1.5rem;
    max-width: 800px;
  }

  .final-cta__description {
    max-width: 700px;
    margin: 0 auto;
    color: #e7efff;
    font-size: clamp(1rem, 2vw, 1.15rem);
    line-height: 1.8;
  }

  .final-cta__emphasis {
    color: #ffffff;
    font-weight: 700;
    line-height: 1.7;
    margin: 1.25rem auto 0;
  }

  .final-cta__actions {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 1rem 1.5rem;
    margin-top: 2.25rem;
  }

  .final-cta__button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    min-height: 54px;
    padding: 0.95rem 1.6rem;
    border: 2px solid transparent;
    border-radius: 12px;
    font: inherit;
    font-weight: 800;
    line-height: 1.3;
    text-align: center;
    text-decoration: none;
    cursor: pointer;
    transition: transform 160ms ease, background 160ms ease, box-shadow 160ms ease;
  }

  .final-cta__button--primary {
    background: #ffd700;
    color: #172b4d;
    box-shadow: 0 10px 24px #002e661f;
  }

  .final-cta__button--primary:hover {
    background: #ffe34d;
    transform: translateY(-2px);
    box-shadow: 0 14px 30px #002e6633;
  }

  .final-cta__button:focus-visible,
  .final-cta__secondary:focus-visible {
    outline: 3px solid #ffffff;
    outline-offset: 4px;
  }

  .final-cta__button svg {
    width: 20px;
    height: 20px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
    flex-shrink: 0;
  }

  .final-cta__secondary {
    color: #ffffff;
    font-weight: 700;
    text-decoration: underline;
    text-decoration-color: #ffffff80;
    text-underline-offset: 5px;
    transition: color 160ms ease;
  }

  .final-cta__secondary:hover {
    color: #ffd700;
    text-decoration-color: currentColor;
  }

  .final-cta__reassurance {
    color: #dce8ff;
    font-size: 0.9rem;
    line-height: 1.7;
    margin: 1.5rem auto 0;
  }

  .final-cta__decoration {
    position: absolute;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
    z-index: -1;
  }

  .final-cta__decoration::before,
  .final-cta__decoration::after {
    content: "";
    position: absolute;
    width: 340px;
    height: 340px;
    border: 1px solid #ffffff14;
    border-radius: 50%;
  }

  .final-cta__decoration::before {
    top: -210px;
    left: -100px;
    box-shadow: 0 0 0 35px #ffffff08, 0 0 0 75px #ffffff05;
  }

  .final-cta__decoration::after {
    right: -150px;
    bottom: -240px;
    box-shadow: 0 0 0 35px #ffffff08, 0 0 0 75px #ffffff05;
  }

  .final-cta__decoration-dot {
    position: absolute;
    width: 12px;
    height: 12px;
    border-radius: 50%;
  }

  .final-cta__decoration-dot--one {
    top: 22%;
    right: 14%;
    background: #ffd700;
  }

  .final-cta__decoration-dot--two {
    bottom: 20%;
    left: 12%;
    background: #00a86b;
  }

  .final-cta__decoration-dot--three {
    top: 17%;
    left: 22%;
    width: 7px;
    height: 7px;
    background: #ffffff;
  }

  @media (max-width: 600px) {
    .final-cta__actions {
      align-items: stretch;
      flex-direction: column;
    }

    .final-cta__button {
      width: 100%;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .final-cta__button,
    .final-cta__secondary {
      transition: none;
    }
  }
</style>

