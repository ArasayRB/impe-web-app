
---
interface CaseConnectedItem {
  title: string;
  description: string;
}

interface Props {
  content: {
    eyebrow: string;
    title: string;
    description: string;
    items: CaseConnectedItem[];
    image?: string | null;
    conclusion: string;
  };
}

const { content } = Astro.props;
---

<section
  id="case-connected"
  class="case-connected-section py-16 sm:py-20 lg:py-24"
  aria-labelledby="case-connected-title"
>
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="grid items-center gap-12 lg:grid-cols-2 lg:gap-16">

      <!-- Gráfico: recursos conectados a un mismo proceso -->
      <div class="connected-visual" aria-hidden="true">
        <div class="connected-visual__halo"></div>

        <svg class="connected-visual__lines" viewBox="0 0 520 440" fill="none">
          <defs>
            <linearGradient id="connected-line-gradient" x1="80" y1="80" x2="440" y2="360" gradientUnits="userSpaceOnUse">
              <stop stop-color="#0057B7" stop-opacity=".7"/>
              <stop offset="1" stop-color="#00A86B" stop-opacity=".7"/>
            </linearGradient>
          </defs>
          <path d="M115 95 L260 220 L405 95 M115 345 L260 220 L405 345 M115 95 L115 345 M405 95 L405 345" stroke="url(#connected-line-gradient)" stroke-width="2" stroke-dasharray="5 7"/>
          <circle cx="260" cy="220" r="104" stroke="#0057B7" stroke-opacity=".13" stroke-width="1.5"/>
          <circle cx="260" cy="220" r="78" stroke="#00A86B" stroke-opacity=".2" stroke-width="1.5"/>
        </svg>

        <div class="connected-visual__node connected-visual__node--document">
          <svg viewBox="0 0 24 24" fill="none">
            <path d="M6 3.75h8l4 4V20.25H6V3.75Z" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"/>
            <path d="M14 3.75v4h4M9 12h6M9 15.5h6" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/>
          </svg>
        </div>

        <div class="connected-visual__node connected-visual__node--people">
          <svg viewBox="0 0 24 24" fill="none">
            <circle cx="9" cy="8" r="3" stroke="currentColor" stroke-width="1.7"/>
            <path d="M3.5 19v-1.5A5.5 5.5 0 0 1 9 12a5.5 5.5 0 0 1 5.5 5.5V19h-11Z" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"/>
            <path d="M15 5.5a3 3 0 0 1 0 5.8M17 13a4.5 4.5 0 0 1 3.5 4.4V19H18" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/>
          </svg>
        </div>

        <div class="connected-visual__node connected-visual__node--calendar">
          <svg viewBox="0 0 24 24" fill="none">
            <rect x="4" y="5.5" width="16" height="15" rx="2" stroke="currentColor" stroke-width="1.7"/>
            <path d="M8 3.5v4M16 3.5v4M4 10h16M8 13.5h2M14 13.5h2" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/>
          </svg>
        </div>

        <div class="connected-visual__node connected-visual__node--tasks">
          <svg viewBox="0 0 24 24" fill="none">
            <rect x="4" y="3.5" width="16" height="17" rx="2.5" stroke="currentColor" stroke-width="1.7"/>
            <path d="m7.5 9 1.5 1.5 2.5-2.5M13.5 9h3M7.5 15l1.5 1.5 2.5-2.5M13.5 15h3" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </div>

        <div class="connected-visual__core">
          <svg viewBox="0 0 80 80" fill="none">
            <circle cx="40" cy="40" r="31" stroke="#FFD700" stroke-width="2"/>
            <circle cx="40" cy="40" r="21" stroke="white" stroke-opacity=".9" stroke-width="1.7"/>
            <circle cx="40" cy="40" r="8" fill="#FFD700"/>
            <path d="M40 9v10M40 61v10M9 40h10M61 40h10" stroke="white" stroke-width="2" stroke-linecap="round"/>
          </svg>
          <span></span>
        </div>

        <span class="connected-visual__spark connected-visual__spark--one"></span>
        <span class="connected-visual__spark connected-visual__spark--two"></span>
        <span class="connected-visual__spark connected-visual__spark--three"></span>
        <span class="connected-visual__spark connected-visual__spark--four"></span>
      </div>

      <!-- Contenido traducido desde el seeder -->
      <div>
        <p class="mb-3 text-sm font-semibold uppercase tracking-widest text-[#0057B7] dark:text-[#FFD700]">
          {content.eyebrow}
        </p>

        <h2
          id="case-connected-title"
          class="text-3xl font-bold tracking-tight text-gray-900 sm:text-4xl dark:text-white"
        >
          {content.title}
        </h2>

        <p class="mt-5 text-base leading-7 text-gray-600 sm:text-lg dark:text-gray-300">
          {content.description}
        </p>

        <ul class="mt-8 space-y-5">
          {content.items.map((item) => (
            <li class="flex gap-4">
              <span
                class="mt-1 flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-blue-100 text-blue-700 dark:bg-blue-900/40 dark:text-blue-300"
                aria-hidden="true"
              >
                <svg class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor">
                  <path fill-rule="evenodd" d="M16.704 5.29a1 1 0 010 1.42l-7.2 7.2a1 1 0 01-1.415 0l-3.6-3.6a1 1 0 011.415-1.42l2.892 2.893 6.493-6.493a1 1 0 011.415 0z" clip-rule="evenodd"/>
                </svg>
              </span>

              <div>
                <h3 class="font-semibold text-gray-900 dark:text-white">
                  {item.title}
                </h3>
                <p class="mt-1 leading-6 text-gray-600 dark:text-gray-300">
                  {item.description}
                </p>
              </div>
            </li>
          ))}
        </ul>
      </div>
    </div>

    <p class="mx-auto mt-12 max-w-3xl text-center text-lg font-semibold leading-8 text-gray-900 sm:mt-16 sm:text-xl dark:text-white">
      {content.conclusion}
    </p>
  </div>
</section>

<style>
  .connected-visual {
    position: relative;
    width: 100%;
    max-width: 560px;
    min-height: 390px;
    margin-inline: auto;
    aspect-ratio: 1.18;
    isolation: isolate;
  }

  .connected-visual__halo {
    position: absolute;
    inset: 14%;
    z-index: -1;
    border-radius: 50%;
    background: radial-gradient(circle, rgb(0 87 183 / 12%), rgb(0 168 107 / 7%) 50%, transparent 73%);
    filter: blur(15px);
  }

  .connected-visual__lines {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: -1;
  }

  .connected-visual__node {
    position: absolute;
    display: grid;
    width: 66px;
    height: 66px;
    place-items: center;
    border: 1px solid rgb(148 163 184 / 25%);
    border-radius: 19px;
    background: white;
    box-shadow: 0 14px 35px rgb(15 23 42 / 9%);
  }

  .connected-visual__node svg { width: 28px; height: 28px; }
  .connected-visual__node--document { top: 12%; left: 12%; color: #0057B7; }
  .connected-visual__node--people { top: 12%; right: 12%; color: #00875a; }
  .connected-visual__node--calendar { bottom: 12%; left: 12%; color: #8a6500; }
  .connected-visual__node--tasks { right: 12%; bottom: 12%; color: #0057B7; }

  :global(.dark) .connected-visual__node {
    border-color: rgb(148 163 184 / 22%);
    background: #111827;
    box-shadow: 0 14px 35px rgb(0 0 0 / 24%);
  }

  .connected-visual__core {
    position: absolute;
    top: 50%;
    left: 50%;
    display: grid;
    width: 146px;
    height: 146px;
    place-items: center;
    border: 1px solid rgb(0 87 183 / 18%);
    border-radius: 50%;
    background: linear-gradient(145deg, #0057B7, #063b78);
    box-shadow: 0 22px 60px rgb(0 87 183 / 24%);
    transform: translate(-50%, -50%);
  }

  .connected-visual__core svg { width: 82px; height: 82px; }

  .connected-visual__core span {
    position: absolute;
    right: 20px;
    bottom: 22px;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #00A86B;
    box-shadow: 0 0 0 5px rgb(0 168 107 / 15%);
  }

  .connected-visual__spark {
    position: absolute;
    width: 8px;
    height: 8px;
    border: 2px solid white;
    border-radius: 50%;
  }

  .connected-visual__spark--one { top: 32%; left: 34%; background: #FFD700; }
  .connected-visual__spark--two { top: 32%; right: 34%; background: #0057B7; }
  .connected-visual__spark--three { bottom: 32%; left: 34%; background: #00A86B; }
  .connected-visual__spark--four { right: 34%; bottom: 32%; background: #FFD700; }

  @media (max-width: 520px) {
    .connected-visual { min-height: 320px; }
    .connected-visual__node { width: 52px; height: 52px; border-radius: 15px; }
    .connected-visual__node svg { width: 23px; height: 23px; }
    .connected-visual__node--document { left: 7%; }
    .connected-visual__node--people { right: 7%; }
    .connected-visual__node--calendar { left: 7%; }
    .connected-visual__node--tasks { right: 7%; }
    .connected-visual__core { width: 122px; height: 122px; }
    .connected-visual__core svg { width: 68px; height: 68px; }
  }
</style>
