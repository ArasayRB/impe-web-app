---
interface CaseConnectedItem {
    title: string;
    description: string;
}

interface Props {
    content: {
        eyebrow: string;
        title: string;
        description: string;
        items: CaseConnectedItem[];
        image: string;
        conclusion: string;
    };
}

const { content } = Astro.props;
---

<section
    id="case-connected"
    class="py-16 sm:py-20 lg:py-24"
    aria-labelledby="case-connected-title"
>
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="grid items-center gap-10 lg:grid-cols-2 lg:gap-16">
            <div>
                <p
                    class="mb-3 text-sm font-semibold uppercase tracking-widest text-blue-700"
                >
                    {content.eyebrow}
                </p>

                <h2
                    id="case-connected-title"
                    class="text-3xl font-bold tracking-tight text-gray-900 sm:text-4xl"
                >
                    {content.title}
                </h2>

                <p class="mt-5 text-base leading-7 text-gray-600 sm:text-lg">
                    {content.description}
                </p>

                <ul class="mt-8 space-y-5">
                    {content.items.map((item) => (
                        <li class="flex gap-4">
                            <span
                                class="mt-1 flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-blue-100 text-blue-700"
                                aria-hidden="true"
                            >
                                <svg
                                    class="h-4 w-4"
                                    viewBox="0 0 20 20"
                                    fill="currentColor"
                                >
                                    <path
                                        fill-rule="evenodd"
                                        d="M16.704 5.29a1 1 0 010 1.42l-7.2 7.2a1 1 0 01-1.415 0l-3.6-3.6a1 1 0 011.415-1.42l2.892 2.893 6.493-6.493a1 1 0 011.415 0z"
                                        clip-rule="evenodd"
                                    />
                                </svg>
                            </span>

                            <div>
                                <h3 class="font-semibold text-gray-900">
                                    {item.title}
                                </h3>

                                <p class="mt-1 leading-6 text-gray-600">
                                    {item.description}
                                </p>
                            </div>
                        </li>
                    ))}
                </ul>
            </div>

            <div class="relative">
                <img
                    src={content.image}
                    alt={content.title}
                    loading="lazy"
                    decoding="async"
                    class="aspect-[4/3] w-full rounded-2xl object-cover shadow-xl"
                />
            </div>
        </div>

        <p
            class="mx-auto mt-12 max-w-3xl text-center text-lg font-semibold leading-8 text-gray-900 sm:mt-16 sm:text-xl"
        >
            {content.conclusion}
        </p>
    </div>
</section>
