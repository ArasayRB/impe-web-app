
---

interface GettingStartedStep {
  title: string;
  description: string;
}

interface Props {
  content: {
    eyebrow: string;
    title: string;
    description: string;
    steps: GettingStartedStep[];
    emphasis: string;
  };
}

const { content } = Astro.props;
---

<section class="getting-started" id="como-empezar">
  <div class="getting-started__container">
    <header class="getting-started__header">
      <p class="getting-started__eyebrow">{content.eyebrow}</p>
      <h2>{content.title}</h2>
      <p class="getting-started__description">{content.description}</p>
    </header>

    <div class="getting-started__steps">
      {content.steps.map((step, index) => (
        <article class="getting-started__step">
          <div class="getting-started__step-top">
            <span class="getting-started__number">
              {String(index + 1).padStart(2, "0")}
            </span>
            {index < content.steps.length - 1 && (
              <span class="getting-started__connector" aria-hidden="true"></span>
            )}
          </div>
          <h3>{step.title}</h3>
          <p>{step.description}</p>
        </article>
      ))}
    </div>

    <p class="getting-started__emphasis">{content.emphasis}</p>
  </div>
</section>

<style>
  .getting-started {
    background: #ffffff;
    color: #172b4d;
    padding: clamp(4rem, 8vw, 7rem) 1.5rem;
  }

  .getting-started__container {
    max-width: 1120px;
    margin-inline: auto;
  }

  .getting-started__header {
    max-width: 780px;
    text-align: center;
    margin: 0 auto 3.5rem;
  }

  .getting-started__eyebrow {
    color: #0057b7;
    font-size: 0.8rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    margin-bottom: 1rem;
  }

  .getting-started h2 {
    font-size: clamp(2rem, 4vw, 3.2rem);
    line-height: 1.12;
    letter-spacing: -0.035em;
    margin: 0 0 1.25rem;
  }

  .getting-started__description {
    color: #52627a;
    font-size: 1.05rem;
    line-height: 1.8;
  }

  .getting-started__steps {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.5rem;
  }

  .getting-started__step {
    position: relative;
    padding: 1.75rem;
    border: 1px solid #e2e9f2;
    border-radius: 20px;
    background: #ffffff;
    box-shadow: 0 12px 32px #172b4d08;
  }

  .getting-started__step-top {
    position: relative;
    display: flex;
    align-items: center;
    margin-bottom: 1.5rem;
    min-height: 48px;
  }

  .getting-started__number {
    position: relative;
    z-index: 1;
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    border-radius: 15px;
    background: #0057b7;
    color: #ffffff;
    font-size: 0.9rem;
    font-weight: 800;
    box-shadow: 0 6px 16px #0057b72b;
  }

  .getting-started__connector {
    position: absolute;
    left: 62px;
    right: -1.75rem;
    height: 2px;
    background: linear-gradient(90deg, #0057b7 0%, #d7e2f1 100%);
  }

  .getting-started__step h3 {
    font-size: 1.15rem;
    line-height: 1.4;
    margin: 0 0 0.7rem;
  }

  .getting-started__step p {
    color: #52627a;
    line-height: 1.75;
    margin: 0;
  }

  .getting-started__emphasis {
    max-width: 820px;
    margin: 2.5rem auto 0;
    padding: 1.25rem 1.5rem;
    border-left: 4px solid #ffd700;
    border-radius: 0 12px 12px 0;
    background: #f7f9fc;
    font-weight: 700;
    line-height: 1.7;
    text-align: center;
  }

  @media (max-width: 760px) {
    .getting-started__steps {
      grid-template-columns: 1fr;
      gap: 1rem;
    }

    .getting-started__connector {
      display: none;
    }
  }
</style>
