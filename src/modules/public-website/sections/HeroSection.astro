
---
interface Props {
  section: {
    key?: string;
    type?: string;
    sort_order?: number;
    content?: {
      title?: string;
      subtitle?: string;
      eyebrow?: string;
      microcopy?: string;
      description?: string;
      image?: string | null;
      actions?: Array<{
        label?: string;
        type?: string;
        url?: string | null;
      }>;
    };
  };
}

const { section } = Astro.props;
const content = section.content ?? {};
const actions = content.actions ?? [];
const primaryAction = actions[0];
const secondaryAction = actions[1];
---

<section
  id={section.key}
  class="ijoba-hero relative isolate overflow-hidden bg-white dark:bg-gray-950"
>
  <div
    class="pointer-events-none absolute -right-32 -top-24 -z-10 h-96 w-96 rounded-full bg-[#0057B7]/10 blur-3xl"
    aria-hidden="true"
  ></div>
  <div
    class="pointer-events-none absolute -bottom-40 -left-32 -z-10 h-96 w-96 rounded-full bg-[#00A86B]/10 blur-3xl"
    aria-hidden="true"
  ></div>

  <div class="mx-auto grid max-w-7xl items-center gap-14 px-6 py-20 sm:py-24 lg:grid-cols-2 lg:gap-16 lg:px-8 lg:py-28">
    <!-- Gráfico conceptual: nodos y recursos conectados -->
    <div class="order-1 lg:order-2">
      <div class="hero-visual relative mx-auto max-w-xl" aria-hidden="true">
        <div class="hero-visual-glow"></div>

        <svg
          class="hero-connections absolute inset-0 h-full w-full"
          viewBox="0 0 560 500"
          fill="none"
        >
          <defs>
            <linearGradient id="hero-line-gradient" x1="90" y1="80" x2="470" y2="420" gradientUnits="userSpaceOnUse">
              <stop stop-color="#0057B7" stop-opacity=".65" />
              <stop offset="1" stop-color="#00A86B" stop-opacity=".65" />
            </linearGradient>
          </defs>

          <path
            d="M280 250 L145 125 M280 250 L420 125 M280 250 L135 365 M280 250 L425 365"
            stroke="url(#hero-line-gradient)"
            stroke-width="2.5"
            stroke-dasharray="6 7"
          />

          <circle cx="280" cy="250" r="106" stroke="#0057B7" stroke-opacity=".12" stroke-width="1.5" />
          <circle cx="280" cy="250" r="132" stroke="#00A86B" stroke-opacity=".12" stroke-width="1.5" />

          <circle cx="145" cy="125" r="5" fill="#FFD700" />
          <circle cx="420" cy="125" r="5" fill="#0057B7" />
          <circle cx="135" cy="365" r="5" fill="#00A86B" />
          <circle cx="425" cy="365" r="5" fill="#FFD700" />
        </svg>

        <!-- Iconos sin texto: el significado no depende del idioma -->
        <div class="hero-resource hero-resource-documents">
          <svg viewBox="0 0 24 24" fill="none">
            <path d="M6 3.75h8l4 4V20.25H6V3.75Z" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"/>
            <path d="M14 3.75v4h4M9 12h6M9 15.5h6" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/>
          </svg>
        </div>

        <div class="hero-resource hero-resource-team">
          <svg viewBox="0 0 24 24" fill="none">
            <circle cx="9" cy="8" r="3" stroke="currentColor" stroke-width="1.7"/>
            <path d="M3.5 19v-1.5A5.5 5.5 0 0 1 9 12a5.5 5.5 0 0 1 5.5 5.5V19h-11Z" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"/>
            <path d="M15 5.5a3 3 0 0 1 0 5.8M17 13a4.5 4.5 0 0 1 3.5 4.4V19H18" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/>
          </svg>
        </div>

        <div class="hero-resource hero-resource-calendar">
          <svg viewBox="0 0 24 24" fill="none">
            <rect x="4" y="5.5" width="16" height="15" rx="2" stroke="currentColor" stroke-width="1.7"/>
            <path d="M8 3.5v4M16 3.5v4M4 10h16M8 13.5h2M8 16.5h2M14 13.5h2" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/>
          </svg>
        </div>

        <div class="hero-resource hero-resource-tasks">
          <svg viewBox="0 0 24 24" fill="none">
            <path d="m5 12.5 4.2 4.2L19 7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            <rect x="3.5" y="3.5" width="17" height="17" rx="4" stroke="currentColor" stroke-width="1.5"/>
          </svg>
        </div>

        <!-- Núcleo central -->
        <div class="hero-core">
          <div class="hero-core-mark">
            <svg viewBox="0 0 64 64" fill="none">
              <circle cx="32" cy="32" r="25" stroke="#FFD700" stroke-width="2.5"/>
              <circle cx="32" cy="32" r="15" stroke="#FFFFFF" stroke-opacity=".85" stroke-width="2"/>
              <circle cx="32" cy="32" r="5" fill="#FFD700"/>
              <path d="M32 7v10M32 47v10M7 32h10M47 32h10" stroke="#FFFFFF" stroke-width="2" stroke-linecap="round"/>
            </svg>
          </div>
          <strong>IJOBA</strong>
          <span class="hero-core-accent"></span>
        </div>

        <!-- Nodos pequeños para dar profundidad al gráfico -->
        <span class="hero-orbit-node hero-node-one"></span>
        <span class="hero-orbit-node hero-node-two"></span>
        <span class="hero-orbit-node hero-node-three"></span>
        <span class="hero-orbit-node hero-node-four"></span>
      </div>
    </div>

    <!-- Contenido traducido desde el seeder -->
    <div class="order-2 max-w-2xl lg:order-1">
      {content.eyebrow && (
        <div class="mb-6">
          <span class="inline-flex items-center rounded-full border border-[#FFD700]/70 bg-[#FFD700]/15 px-4 py-2 text-xs font-bold tracking-wider text-[#0057B7] dark:text-[#FFD700]">
            {content.eyebrow}
          </span>
        </div>
      )}

      {content.title && (
        <h1 class="text-4xl font-bold tracking-tight text-gray-950 sm:text-5xl lg:text-6xl dark:text-white">
          {content.title}
        </h1>
      )}

      {content.description && (
        <p class="mt-7 max-w-xl text-lg leading-8 text-gray-600 sm:text-xl dark:text-gray-300">
          {content.description}
        </p>
      )}

      {actions.length > 0 && (
        <div class="mt-10 flex flex-wrap items-center gap-4">
          {primaryAction?.url && (
            primaryAction.type === 'modal' ? (
              <button
                type="button"
                data-registration-trigger
                class="group inline-flex min-h-12 items-center justify-center gap-2 rounded-full bg-[#0057B7] px-7 py-3.5 text-sm font-semibold text-white shadow-lg transition hover:-translate-y-0.5 hover:bg-[#00479A] focus:outline-none focus:ring-2 focus:ring-[#0057B7] focus:ring-offset-2"
              >
                {primaryAction.label}
                <svg class="h-4 w-4 transition-transform group-hover:translate-x-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14m-7-7 7 7-7 7" />
                </svg>
              </button>
            ) : (
              <a
                href={primaryAction.url}
                class="group inline-flex min-h-12 items-center justify-center gap-2 rounded-full bg-[#0057B7] px-7 py-3.5 text-sm font-semibold text-white shadow-lg transition hover:-translate-y-0.5 hover:bg-[#00479A] focus:outline-none focus:ring-2 focus:ring-[#0057B7] focus:ring-offset-2"
              >
                {primaryAction.label}
                <svg class="h-4 w-4 transition-transform group-hover:translate-x-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14m-7-7 7 7-7 7" />
                </svg>
              </a>
            )
          )}

          {secondaryAction?.url && (
            <a
              href={secondaryAction.url}
              class="inline-flex items-center justify-center rounded-full px-6 py-3.5 text-sm font-semibold text-gray-700 transition-colors hover:text-[#0057B7] dark:text-gray-300 dark:hover:text-white"
            >
              {secondaryAction.label}
            </a>
          )}
        </div>
      )}

      {content.microcopy && (
        <p class="mt-4 text-sm text-gray-500 dark:text-gray-400">{content.microcopy}</p>
      )}
    </div>
  </div>
</section>

<style>
  .hero-visual {
    min-height: 430px;
    aspect-ratio: 1.12;
    isolation: isolate;
  }

  .hero-visual-glow {
    position: absolute;
    inset: 15%;
    z-index: -1;
    border-radius: 50%;
    background: radial-gradient(circle, rgb(0 87 183 / 12%), rgb(0 168 107 / 7%) 48%, transparent 72%);
    filter: blur(14px);
  }

  .hero-connections { z-index: -1; }

  .hero-resource {
    position: absolute;
    display: grid;
    width: 66px;
    height: 66px;
    place-items: center;
    border: 1px solid rgb(148 163 184 / 25%);
    border-radius: 20px;
    background: rgb(255 255 255 / 96%);
    box-shadow: 0 16px 40px rgb(15 23 42 / 10%);
    backdrop-filter: blur(12px);
  }

  .hero-resource svg {
    width: 28px;
    height: 28px;
  }

  :global(.dark) .hero-resource {
    border-color: rgb(148 163 184 / 22%);
    background: rgb(17 24 39 / 96%);
    box-shadow: 0 16px 40px rgb(0 0 0 / 24%);
  }

  .hero-resource-documents {
    top: 14%;
    left: 13%;
    color: #0057B7;
  }

  .hero-resource-team {
    top: 14%;
    right: 13%;
    color: #00875a;
  }

  .hero-resource-calendar {
    bottom: 19%;
    left: 12%;
    color: #8a6500;
  }

  .hero-resource-tasks {
    right: 12%;
    bottom: 19%;
    color: #0057B7;
  }

  .hero-core {
    position: absolute;
    top: 50%;
    left: 50%;
    display: flex;
    width: 164px;
    height: 164px;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    border: 1px solid rgb(0 87 183 / 18%);
    border-radius: 50%;
    background: linear-gradient(145deg, #0057B7, #063b78);
    box-shadow: 0 24px 65px rgb(0 87 183 / 26%), inset 0 1px 0 rgb(255 255 255 / 25%);
    transform: translate(-50%, -50%);
    color: white;
  }

  .hero-core-mark {
    width: 58px;
    height: 58px;
    margin-bottom: 5px;
  }

  .hero-core-mark svg { width: 100%; height: 100%; }

  .hero-core strong {
    font-size: 20px;
    font-weight: 800;
    letter-spacing: .13em;
  }

  .hero-core-accent {
    width: 22px;
    height: 3px;
    margin-top: 9px;
    border-radius: 999px;
    background: #FFD700;
  }

  .hero-orbit-node {
    position: absolute;
    width: 8px;
    height: 8px;
    border: 2px solid white;
    border-radius: 50%;
    box-shadow: 0 0 0 4px rgb(0 87 183 / 10%);
  }

  .hero-node-one { top: 30%; left: 37%; background: #FFD700; }
  .hero-node-two { top: 31%; right: 35%; background: #0057B7; }
  .hero-node-three { bottom: 31%; left: 36%; background: #00A86B; }
  .hero-node-four { right: 35%; bottom: 30%; background: #FFD700; }

  @media (max-width: 520px) {
    .hero-visual { min-height: 340px; }
    .hero-resource {
      width: 52px;
      height: 52px;
      border-radius: 15px;
    }
    .hero-resource svg { width: 23px; height: 23px; }
    .hero-resource-documents { top: 13%; left: 8%; }
    .hero-resource-team { top: 13%; right: 8%; }
    .hero-resource-calendar { bottom: 18%; left: 7%; }
    .hero-resource-tasks { right: 7%; bottom: 18%; }
    .hero-core { width: 130px; height: 130px; }
    .hero-core-mark { width: 45px; height: 45px; }
    .hero-core strong { font-size: 17px; }
    .hero-core-accent { margin-top: 6px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-resource, .hero-core { transition: none; }
  }
</style>
