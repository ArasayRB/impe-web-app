---
interface NavigationItem {
  key?: string;
  label?: string;
  url?: string;
  type?: string;
  target?: string;
  sort_order?: number;
  active?: boolean;
}

interface Props {
  navigation: NavigationItem[];
  logo?: string | null;
  title?: string | null;
  cta?: {
    label?: string;
    url?: string | null;
    type?: string;
  } | null;
  locale: string;
}

const {
  navigation = [],
  logo = null,
  title = '',
  cta = null,
  locale,
} = Astro.props;

const activeNavigation =
  navigation.filter(
    item => item.active !== false
  );
---

<header
  class="sticky top-0 z-50 border-b border-gray-200/70 bg-white/80 backdrop-blur-xl dark:border-gray-800/70 dark:bg-gray-950/80"
>
  <div class="mx-auto max-w-7xl px-6 lg:px-8">

    <div class="flex h-20 items-center justify-between">

      <!-- Logo -->

      <a
        href="/"
        class="flex items-center gap-3"
        aria-label={title || 'Home'}
      >
        {
          logo ? (
            <img
              src={logo}
              alt={title || ''}
              class="h-9 w-auto object-contain"
            />
          ) : (
            <span class="text-xl font-bold tracking-tight text-gray-950 dark:text-white">
              {title}
            </span>
          )
        }
      </a>

      <!-- Desktop navigation -->

      <nav
        class="hidden items-center gap-8 md:flex"
        aria-label="Main navigation"
      >
        {
          activeNavigation.map((item) => (
            <a
              href={item.url || '#'}
              target={item.target || '_self'}
              class="public-nav-link text-sm font-medium text-gray-600 transition-colors hover:text-gray-950 dark:text-gray-300 dark:hover:text-white"
            >
              {item.label}
            </a>
          ))
        }
      </nav>

      <!-- Desktop CTA -->

      <div class="hidden items-center md:flex">
        {
          cta?.label && (
            <a
              href={cta.url || '#contact'}
              class="public-nav-link inline-flex items-center justify-center rounded-full bg-gray-950 px-5 py-2.5 text-sm font-semibold text-white shadow-sm transition-all hover:-translate-y-0.5 hover:bg-gray-800 hover:shadow-lg focus:outline-none focus:ring-2 focus:ring-gray-950 focus:ring-offset-2 dark:bg-white dark:text-gray-950 dark:hover:bg-gray-200"
            >
              {cta.label}
            </a>
          )
        }
      </div>

			      <!-- Language selector -->

      <div class="hidden items-center gap-1 md:flex">
        <a
          href="/es"
          aria-current={locale === 'es' ? 'page' : undefined}
          class:list={[
            "rounded-md px-2 py-1 text-xs font-semibold transition-colors",
            locale === 'es'
              ? "bg-gray-100 text-gray-950 dark:bg-gray-800 dark:text-white"
              : "text-gray-500 hover:text-gray-950 dark:text-gray-400 dark:hover:text-white"
          ]}
        >
          ES
        </a>

        <span class="text-gray-300 dark:text-gray-700">
          |
        </span>

        <a
          href="/en"
          aria-current={locale === 'en' ? 'page' : undefined}
          class:list={[
            "rounded-md px-2 py-1 text-xs font-semibold transition-colors",
            locale === 'en'
              ? "bg-gray-100 text-gray-950 dark:bg-gray-800 dark:text-white"
              : "text-gray-500 hover:text-gray-950 dark:text-gray-400 dark:hover:text-white"
          ]}
        >
          EN
        </a>
      </div>

      <!-- Mobile button -->

      <button
        type="button"
        id="public-mobile-menu-button"
        class="inline-flex items-center justify-center rounded-lg p-2 text-gray-600 transition-colors hover:bg-gray-100 hover:text-gray-950 md:hidden dark:text-gray-300 dark:hover:bg-gray-800 dark:hover:text-white"
        aria-label="Open navigation"
        aria-expanded="false"
        aria-controls="public-mobile-menu"
      >
        <svg
          id="public-mobile-menu-icon"
          class="h-6 w-6"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          stroke-width="2"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M4 6h16M4 12h16M4 18h16"
          />
        </svg>
      </button>

    </div>

    <!-- Mobile navigation -->

    <div
      id="public-mobile-menu"
      class="hidden border-t border-gray-200 py-5 md:hidden dark:border-gray-800"
    >
      <nav
        class="flex flex-col gap-1"
        aria-label="Mobile navigation"
      >
        {
          activeNavigation.map((item) => (
            <a
              href={item.url || '#'}
              target={item.target || '_self'}
              class="public-nav-link rounded-lg px-4 py-3 text-sm font-medium text-gray-700 transition-colors hover:bg-gray-100 hover:text-gray-950 dark:text-gray-200 dark:hover:bg-gray-800 dark:hover:text-white"
            >
              {item.label}
            </a>
          ))
        }
      </nav>

      {
        cta?.label && (
          <div class="mt-4 px-4 pb-1">
            <a
              href={cta.url || '#contact'}
              class="public-nav-link flex w-full items-center justify-center rounded-full bg-gray-950 px-5 py-3 text-sm font-semibold text-white shadow-sm transition-all hover:bg-gray-800 dark:bg-white dark:text-gray-950 dark:hover:bg-gray-200"
            >
              {cta.label}
            </a>
          </div>
        )
      }
    </div>

  </div>
</header>

<!-- Back to top -->

<button
  type="button"
  id="public-back-to-top"
  class="fixed bottom-6 right-6 z-40 hidden h-11 w-11 items-center justify-center rounded-full border border-gray-200 bg-white/90 text-gray-700 shadow-xl shadow-gray-900/10 backdrop-blur transition-all duration-200 hover:-translate-y-1 hover:bg-gray-950 hover:text-white focus:outline-none focus:ring-2 focus:ring-gray-950 focus:ring-offset-2 dark:border-gray-800 dark:bg-gray-900/90 dark:text-gray-200 dark:hover:bg-white dark:hover:text-gray-950"
  aria-label="Back to top"
>
  <svg
    class="h-5 w-5"
    fill="none"
    viewBox="0 0 24 24"
    stroke="currentColor"
    stroke-width="2"
    aria-hidden="true"
  >
    <path
      stroke-linecap="round"
      stroke-linejoin="round"
      d="M5 15l7-7 7 7"
    />
  </svg>
</button>

<script>
  const menuButton =
    document.getElementById(
      'public-mobile-menu-button'
    );

  const menu =
    document.getElementById(
      'public-mobile-menu'
    );

  const backToTop =
    document.getElementById(
      'public-back-to-top'
    );

  const navLinks =
    document.querySelectorAll(
      '.public-nav-link'
    );

  const closeMobileMenu = () => {
    if (!menu || !menuButton) {
      return;
    }

    menu.classList.add('hidden');

    menuButton.setAttribute(
      'aria-expanded',
      'false'
    );
  };

  if (menuButton && menu) {
    menuButton.addEventListener(
      'click',
      () => {
        const isOpen =
          !menu.classList.contains('hidden');

        menu.classList.toggle(
          'hidden',
          isOpen
        );

        menuButton.setAttribute(
          'aria-expanded',
          String(!isOpen)
        );
      }
    );
  }

  navLinks.forEach((link) => {
    link.addEventListener(
      'click',
      () => {
        closeMobileMenu();
      }
    );
  });

  const updateBackToTop = () => {
    if (!backToTop) {
      return;
    }

    const shouldShow =
      window.scrollY > 500;

    backToTop.classList.toggle(
      'hidden',
      !shouldShow
    );

    backToTop.classList.toggle(
      'flex',
      shouldShow
    );
  };

  window.addEventListener(
    'scroll',
    updateBackToTop,
    { passive: true }
  );

  if (backToTop) {
    backToTop.addEventListener(
      'click',
      () => {
        window.scrollTo({
          top: 0,
          behavior: 'smooth',
        });
      }
    );
  }

  updateBackToTop();
</script>

<style>
  :global(html) {
    scroll-behavior: smooth;
  }

  :global(section[id]) {
    scroll-margin-top: 6rem;
  }
</style>
