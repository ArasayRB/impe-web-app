---
import type {
  PublicWebsiteSnapshot
} from '@/services/public.website.service';
import RegistrationInvitationModal from '@/components/public/RegistrationInvitationModal.astro';
import HeroSection from './sections/HeroSection.astro';
import AboutSection from './sections/AboutSection.astro';
import CaseConnectedSection from './sections/CaseConnectedSection.astro';
import CalendarFollowUpSection from './sections/CalendarFollowUpSection.astro';
import AutomationSection from './sections/AutomationSection.astro';
import EmailCommunicationSection from './sections/EmailCommunicationSection.astro';
import GrowthSection from './sections/GrowthSection.astro';
import SecuritySection from './sections/SecuritySection.astro';
import TeamCollaboratorsSection from './sections/TeamCollaboratorsSection.astro';
import GettingStartedSection from './sections/GettingStartedSection.astro';
import FinalCtaSection from './sections/FinalCtaSection.astro';
import PublicHeader from './sections/PublicHeader.astro';
import ContactSection from './sections/ContactSection.astro';
import TeamSection from './sections/TeamSection.astro';
import PlansSection from './sections/PlansSection.astro';
import FooterSection from './sections/FooterSection.astro';

interface Props {
  snapshot: PublicWebsiteSnapshot;
  locale: string;
}

const {
  snapshot,
  locale,
} = Astro.props;


const navigation = snapshot.navigation?.[locale] ?? []; 
const sections = snapshot.sections?.[locale] ?? []; 
const ctas = snapshot.cta?.[locale] ?? []; 
const contact = snapshot.contact?.[locale] ?? []; 
const contactSubmission = snapshot.contact?.submission;
const contactSecurity = snapshot.contact?.security;
const team = snapshot.team?.[locale] ?? [];
const plans = snapshot.plans ?? [];
const socials = snapshot.social ?? [];
const legal = snapshot.legal?.[locale] ?? {};

navigation.sort(
  (a, b) =>
    (a.sort_order ?? 0) -
    (b.sort_order ?? 0)
);

sections.sort(
  (a, b) =>
    (a.sort_order ?? 0) -
    (b.sort_order ?? 0)
);

ctas.sort(
  (a, b) =>
    (a.sort_order ?? 0) -
    (b.sort_order ?? 0)
);

contact.sort(
  (a, b) =>
    (a.sort_order ?? 0) -
    (b.sort_order ?? 0)
);

team.sort(
  (a, b) =>
    (a.sort_order ?? 0) -
    (b.sort_order ?? 0)
);
---

<div class="public-website">

  <!-- Navigation -->  

	<PublicHeader
		navigation={navigation}
		logo={snapshot.branding?.logo}
		title={snapshot.branding?.title}
		cta={ctas[0]}
    locale={locale}
	/>

  <!-- Sections -->
  <main>
    {
			sections.map((section) => (
				<>
					{
						section.type === 'hero' && (
							<HeroSection section={section} />
						)
					}

					{
						section.type === 'about' && (
							<AboutSection section={section} />
						)
					}

					{
						section.type === 'case_conected' && (
							<CaseConnectedSection content={section.content} />
						)
					}

					{
						section.type === 'calendar_follow_up' && (
							<CalendarFollowUpSection content={section.content} />
						)
					}

					{
						section.type === 'automation' && (
							<AutomationSection content={section.content} />
						)
					}

					{
						section.type === 'email_communication' && (
							<EmailCommunicationSection content={section.content} />
						)
					}

					{
						section.type === 'growth' && (
							<GrowthSection content={section.content} />
						)
					}

					{
						section.type === 'security' && (
							<SecuritySection content={section.content} />
						)
					}

					{
						section.type === 'team_collaborators' && (
							<TeamCollaboratorsSection content={section.content} />
						)
					}

					{
						section.type === 'getting_started' && (
							<GettingStartedSection content={section.content} />
						)
					}


					{
						section.type === 'final_cta' && (
							<FinalCtaSection content={section.content} section={section}/>
						)
					}

					{
					 section.type === 'team' && team.length > 0 && (
						 <TeamSection 
							title={section.content?.title} 
							description={section.content?.description} 
							members={team} 
						 /> 

					 ) 
					}
				</>
			))
		}

		<!-- <PlansSection
			plans={plans}
  		locale={locale}
		/> -->
		
		<ContactSection
		section={{
			key: 'contact'
		}}
		fields={contact}
		submission={contactSubmission}
		security={contactSecurity}
		locale={locale}
	/>
  </main>
	<!-- Footer --> 
	<FooterSection 
		socials={socials} 
		legal={legal} 
		locale={locale} 
	/>

	<!-- Registration Invitation Modal -->
	<RegistrationInvitationModal />

</div>
