---
import type {
	CaseWorkflowResponse
} from './cases.types';

interface Props {
	initialData: CaseWorkflowResponse;
}

const {
	initialData
} = Astro.props;

const caseData =
	initialData.data.case;

const workflow =
	initialData.data.workflow;
---

<div
	id="case-workflow"
	class="p-6"
	data-case-id={caseData.id}
>

	<!-- Header -->

	<div
		class="
			mb-6
			flex
			items-center
			justify-between
		"
	>

		<div>

			<h1
				class="
					text-2xl
					font-semibold
					text-gray-900
					dark:text-white
				"
			>
				{caseData.case_number}
			</h1>

			<p
				class="
					mt-1
					text-sm
					text-gray-500
					dark:text-gray-400
				"
			>
				Workflow
			</p>

		</div>

		<div
			class="
				rounded-full
				bg-gray-100
				px-3
				py-1
				text-sm
				font-medium
				text-gray-700
				dark:bg-gray-700
				dark:text-gray-200
			"
		>
			{caseData.status}
		</div>

	</div>


	<!-- Workflow -->

	<div
		class="
			rounded-lg
			border
			border-gray-200
			bg-white
			p-6
			shadow-sm
			dark:border-gray-700
			dark:bg-gray-800
		"
	>

		<div
			class="
				mb-8
				flex
				items-center
				justify-between
			"
		>

			<div>

				<h2
					class="
						text-lg
						font-semibold
						text-gray-900
						dark:text-white
					"
				>
					Workflow
				</h2>

				<p
					class="
						mt-1
						text-sm
						text-gray-500
						dark:text-gray-400
					"
				>
					Current process
				</p>

			</div>

			{workflow.paused && (

				<span
					class="
						rounded-full
						bg-yellow-100
						px-3
						py-1
						text-xs
						font-medium
						text-yellow-800
						dark:bg-yellow-900/30
						dark:text-yellow-400
					"
				>
					Paused
				</span>

			)}

		</div>


		<!-- Steps -->

		<div
			class="relative"
			data-workflow-steps
		>

			{workflow.steps.map(
				(step, index) => (

					<div
						class="relative flex gap-4 pb-8 last:pb-0"
						data-workflow-step={step.key}
					>

						<!-- Line -->

						{index <
							workflow.steps.length - 1 && (

							<div
								class="
									absolute
									left-[15px]
									top-8
									h-full
									w-px
									bg-gray-200
									dark:bg-gray-700
								"
							>
							</div>

						)}


						<!-- Status -->

						<div
							class="
								relative
								z-10
								flex
								h-8
								w-8
								shrink-0
								items-center
								justify-center
								rounded-full
								border-2
							"
							data-step-status={step.status}
						>

							{step.status === 'completed' ? (

								<svg
									class="h-4 w-4"
									fill="none"
									stroke="currentColor"
									viewBox="0 0 24 24"
								>
									<path
										stroke-linecap="round"
										stroke-linejoin="round"
										stroke-width="2"
										d="M5 13l4 4L19 7"
									/>
								</svg>

							) : step.status === 'active' ? (

								<div
									class="
										h-2.5
										w-2.5
										rounded-full
									"
								>
								</div>

							) : (

								<div
									class="
										h-2
										w-2
										rounded-full
										bg-gray-400
									"
								>
								</div>

							)}

						</div>


						<!-- Step content -->

						<div class="min-w-0 flex-1">

							<div
								class="
									flex
									flex-wrap
									items-center
									gap-2
								"
							>

								<h3
									class="
										font-medium
										text-gray-900
										dark:text-white
									"
								>
									{step.label}
								</h3>


								{step.status === 'active' && (

									<span
										class="
											rounded-full
											bg-blue-100
											px-2.5
											py-0.5
											text-xs
											font-medium
											text-blue-800
											dark:bg-blue-900/30
											dark:text-blue-400
										"
									>
										Active
									</span>

								)}


								{step.forced && (

									<span
										class="
											rounded-full
											bg-yellow-100
											px-2.5
											py-0.5
											text-xs
											font-medium
											text-yellow-800
											dark:bg-yellow-900/30
											dark:text-yellow-400
										"
									>
										Forced
									</span>

								)}

							</div>


							<!-- Dates -->

							<div
								class="
									mt-2
									flex
									flex-wrap
									gap-x-6
									gap-y-1
									text-xs
									text-gray-500
									dark:text-gray-400
								"
							>

								{step.started_at && (

									<span>
										Started:
										{step.started_at}
									</span>

								)}

								{step.finished_at && (

									<span>
										Finished:
										{step.finished_at}
									</span>

								)}

							</div>


							<!-- Force details -->

							{step.forced &&
								step.force_details.length > 0 && (

								<div
									class="
										mt-4
										rounded-lg
										border
										border-yellow-200
										bg-yellow-50
										p-4
										dark:border-yellow-800
										dark:bg-yellow-900/10
									"
								>

									<div
										class="
											mb-2
											text-sm
											font-medium
											text-yellow-800
											dark:text-yellow-400
										"
									>
										Force details
									</div>


									{step.force_details.map(
										(detail) => (

											<div
												class="
													text-sm
													text-gray-700
													dark:text-gray-300
												"
											>

												<p>
													{detail.description}
												</p>

												{detail.metadata.requirements.length >
													0 && (

													<ul
														class="
															mt-2
															list-disc
															pl-5
															text-xs
														"
													>

														{detail.metadata.requirements.map(
															(requirement) => (

																<li>
																	{requirement}
																</li>

															)
														)}

													</ul>

												)}

												<div
													class="
														mt-2
														text-xs
														text-gray-500
														dark:text-gray-400
													"
												>
													{detail.created_at}
												</div>

											</div>

										)
									)}

								</div>

							)}

						</div>

					</div>

				)
			)}

		</div>

	</div>

</div>
