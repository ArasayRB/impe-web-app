---
// Cases.astro
import NavPagination from '@/components/NavPagination.astro';
import {resolveSite} from '@/lib/resolveSite';
import AddCustomerForm from '@/modules/customers/forms/add.astro';
import AddCaseForm from '@/modules/cases/forms/add.astro';
import DeleteCaseForm from '@/modules/cases/forms/delete.astro';
import EditCaseForm from '@/modules/cases/forms/edit.astro';
import Workflow from '@/modules/cases/partials/workflow.astro';
import SearchCaseInput from '@/modules/cases/case-search.astro';
import { getServerTranslator } from '@/lib/i18n/server';
import { lang } from '@/lib/i18n/config';
import { resolveLocale } from '@/lib/i18n/resolveLocale';

const { initialData } = Astro.props;
const { class: clazz } = Astro.props;
const site = resolveSite(Astro);
const locale = resolveLocale(Astro);

const t = await getServerTranslator(locale, lang);

---

<entities-crud
	id="cases-root"	
  	data-site={JSON.stringify(site)}
	data-initial={JSON.stringify(initialData || { initialData: [], meta: {} })}
	class:list={['block overflow-hidden shadow', clazz]}
>
	<div id="cases-error" class="hidden text-red-500 p-4">
		
	</div>
	<div
		class="p-4 pt-16 bg-white block sm:flex items-center justify-between border-b border-gray-200 lg:mt-1.5 dark:bg-gray-800 dark:border-gray-700"
	>
		<div class="w-full mb-1">
			<div class="mb-4">
				<nav class="flex mb-5" aria-label="Breadcrumb">
					<ol
						class="inline-flex items-center space-x-1 text-sm font-medium md:space-x-2"
					>
						<li class="inline-flex items-center">
							<a
								href="#"
								class="inline-flex items-center text-gray-700 hover:text-primary-600 dark:text-gray-300 dark:hover:text-white"
							>
								<svg class="w-5 h-5 mr-2.5 text-gray-500 transition duration-75 group-hover:text-gray-900 dark:text-gray-400 
									dark:group-hover:text-white" fill="currentColor" viewBox="0 0 20 20" xmlns="http://www.w3.org/2000/svg">
									<path d="M2 10a8 8 0 018-8v8h8a8 8 0 11-16 0z"></path>
									<path d="M12 2.252A8.014 8.014 0 0117.748 8H12V2.252z"></path>
								</svg>
								<span data-i18n="sidebar.title.resources">{t('sidebar.title.resources')}</span>
							</a>
						</li>
						<li>
							<div class="flex items-center">
								<svg
									class="w-6 h-6 text-gray-400"
									fill="currentColor"
									viewBox="0 0 20 20"
									xmlns="http://www.w3.org/2000/svg"
									><path
										fill-rule="evenodd"
										d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z"
										clip-rule="evenodd"></path></svg
								>
								<a
									href="#"
									class="ml-1 text-gray-700 hover:text-primary-600 md:ml-2 dark:text-gray-300 dark:hover:text-white"
									data-i18n="sidebar.dashboard.cases"
									>{t('sidebar.dashboard.cases')}</a
								>
							</div>
						</li>
					</ol>
				</nav>
				<h1
					class="text-xl font-semibold text-gray-900 sm:text-2xl dark:text-white"
					data-i18n="common.crud.list"
				>
					{t('common.crud.list')}
				</h1>
			</div>
			<div class="sm:flex">
				<div
					class="items-center hidden mb-3 sm:flex sm:divide-x sm:divide-gray-100 sm:mb-0 dark:divide-gray-700"
				>
					<SearchCaseInput data-label="{}"/>
					<div class="flex pl-0 mt-3 space-x-1 sm:pl-2 sm:mt-0">
						<!-- Setting access -->
						<button
							data-settings
							class="inline-flex justify-center p-1 text-gray-500 rounded cursor-pointer hover:text-gray-900 hover:bg-gray-100 dark:text-gray-400 dark:hover:bg-gray-700 dark:hover:text-white"
						>
							<svg
								class="w-6 h-6"
								fill="currentColor"
								viewBox="0 0 20 20"
								xmlns="http://www.w3.org/2000/svg"
								><path
									fill-rule="evenodd"
									d="M11.49 3.17c-.38-1.56-2.6-1.56-2.98 0a1.532 1.532 0 01-2.286.948c-1.372-.836-2.942.734-2.106 2.106.54.886.061 2.042-.947 2.287-1.561.379-1.561 2.6 0 2.978a1.532 1.532 0 01.947 2.287c-.836 1.372.734 2.942 2.106 2.106a1.532 1.532 0 012.287.947c.379 1.561 2.6 1.561 2.978 0a1.533 1.533 0 012.287-.947c1.372.836 2.942-.734 2.106-2.106a1.533 1.533 0 01.947-2.287c1.561-.379 1.561-2.6 0-2.978a1.532 1.532 0 01-.947-2.287c.836-1.372-.734-2.942-2.106-2.106a1.532 1.532 0 01-2.287-.947zM10 13a3 3 0 100-6 3 3 0 000 6z"
									clip-rule="evenodd"></path></svg
							>
						</button>
						<!-- TRASH ICON SVG -->
						<button
							data-bulk-delete
							disabled
							class="
								inline-flex
								justify-center
								p-1
								text-gray-500
								rounded
								dark:text-gray-400

								enabled:cursor-pointer
								enabled:hover:text-gray-900
								enabled:hover:bg-gray-100
								enabled:dark:hover:bg-gray-700
								enabled:dark:hover:text-white

								disabled:opacity-50
								disabled:cursor-not-allowed
								"
						>
							<svg
								class="w-6 h-6"
								fill="currentColor"
								viewBox="0 0 20 20"
								xmlns="http://www.w3.org/2000/svg"
								><path
									fill-rule="evenodd"
									d="M9 2a1 1 0 00-.894.553L7.382 4H4a1 1 0 000 2v10a2 2 0 002 2h8a2 2 0 002-2V6a1 1 0 100-2h-3.382l-.724-1.447A1 1 0 0011 2H9zM7 8a1 1 0 012 0v6a1 1 0 11-2 0V8zm5-1a1 1 0 00-1 1v6a1 1 0 102 0V8a1 1 0 00-1-1z"
									clip-rule="evenodd"></path></svg
							>
						</button>
						<!-- Analytics access -->
						<button
							data-info
							class="inline-flex justify-center p-1 text-gray-500 rounded cursor-pointer hover:text-gray-900 hover:bg-gray-100 dark:text-gray-400 dark:hover:bg-gray-700 dark:hover:text-white"
						>
							<svg
								class="w-6 h-6"
								fill="currentColor"
								viewBox="0 0 20 20"
								xmlns="http://www.w3.org/2000/svg"
								><path
									fill-rule="evenodd"
									d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7 4a1 1 0 11-2 0 1 1 0 012 0zm-1-9a1 1 0 00-1 1v4a1 1 0 102 0V6a1 1 0 00-1-1z"
									clip-rule="evenodd"></path></svg
							>
						</button>
						<!-- Extra actions as export,import... -->
						<div class="relative">
							<button
								type="button"
								data-actions-toggle
								class="inline-flex justify-center p-1 text-gray-500 rounded cursor-pointer hover:text-gray-900 hover:bg-gray-100 dark:text-gray-400 dark:hover:bg-gray-700 dark:hover:text-white"
							>
								<svg
									class="w-6 h-6"
									fill="currentColor"
									viewBox="0 0 20 20"
								>
									<path
										d="M10 6a2 2 0 110-4 2 2 0 010 4zM10 12a2 2 0 110-4 2 2 0 010 4zM10 18a2 2 0 110-4 2 2 0 010 4z"
									/>
								</svg>
							</button>

							<div
								data-actions-menu
								class="hidden absolute right-0 z-50 mt-2 w-56 bg-white rounded-lg shadow dark:bg-gray-800"
							>
								<button
									data-export-all
									class="inline-flex items-center w-full text-left text-gray-500 px-4 py-2 hover:bg-gray-100 dark:hover:bg-gray-700"
								>
									<svg
										class="w-5 h-5 mr-2 -ml-1"
										fill="currentColor"
										viewBox="0 0 20 20"
										xmlns="http://www.w3.org/2000/svg"
										><path
											fill-rule="evenodd"
											d="M6 2a2 2 0 00-2 2v12a2 2 0 002 2h8a2 2 0 002-2V7.414A2 2 0 0015.414 6L12 2.586A2 2 0 0010.586 2H6zm5 6a1 1 0 10-2 0v3.586l-1.293-1.293a1 1 0 10-1.414 1.414l3 3a1 1 0 001.414 0l3-3a1 1 0 00-1.414-1.414L11 11.586V8z"
											clip-rule="evenodd"></path></svg
									>
									<span data-i18n="common.crud.export_all">{t('common.crud.export_all')}</span>
								</button>

								<button
									disabled
									data-export-selected
									class="
									inline-flex items-center w-full 
									text-left text-gray-500 px-4 py-2 
									enabled:hover:text-gray-900
									enabled:hover:bg-gray-100
									enabled:dark:hover:bg-gray-700
									enabled:dark:hover:text-white

									disabled:opacity-50
									disabled:cursor-not-allowed
									"
								>
									<svg
										class="w-5 h-5 mr-2 -ml-1"
										fill="currentColor"
										viewBox="0 0 20 20"
										xmlns="http://www.w3.org/2000/svg"
										><path
											fill-rule="evenodd"
											d="M6 2a2 2 0 00-2 2v12a2 2 0 002 2h8a2 2 0 002-2V7.414A2 2 0 0015.414 6L12 2.586A2 2 0 0010.586 2H6zm5 6a1 1 0 10-2 0v3.586l-1.293-1.293a1 1 0 10-1.414 1.414l3 3a1 1 0 001.414 0l3-3a1 1 0 00-1.414-1.414L11 11.586V8z"
											clip-rule="evenodd"></path></svg
									>
									<span data-i18n="common.crud.export_selected">{t('common.crud.export_selected')}</span>
								</button>
								<button
									data-import
									class=" inline-flex items-center  w-full text-left text-gray-500 px-4 py-2 hover:bg-gray-100 dark:hover:bg-gray-700"
								>
									<svg
										class="w-5 h-5 mr-2 -ml-1"
										fill="currentColor"
										viewBox="0 0 20 20"
										xmlns="http://www.w3.org/2000/svg"
									>
										<path
											fill-rule="evenodd"
											d="M3 4a2 2 0 012-2h8a2 2 0 011.414.586l2 2A2 2 0 0117 6v10a2 2 0 01-2 2H5a2 2 0 01-2-2V4zm7 2a1 1 0 00-2 0v5.586L6.707 10.293a1 1 0 00-1.414 1.414l3 3a1 1 0 001.414 0l3-3a1 1 0 00-1.414-1.414L10 11.586V6z"
											clip-rule="evenodd"
										/>
									</svg>
									<span data-i18n="common.crud.import">{t('common.crud.import')}</span>
								</button>
							</div>
						</div>
					</div>
				</div>
				<div class="flex items-center ml-auto space-x-2 sm:space-x-3">
					<!-- NOTE: Not implemented (see `./CrudProducts` for reference) -->
					<!-- <button
						type="button"
						data-refresh
						class="inline-flex items-center justify-center w-1/2 px-3 py-2 text-sm font-medium text-center text-white rounded-lg bg-primary-700 hover:bg-primary-800 focus:ring-4 focus:ring-primary-300 sm:w-auto dark:bg-primary-600 dark:hover:bg-primary-700 dark:focus:ring-primary-800"
					>
						<svg
							class="w-5 h-5 mr-2 -ml-1"
							fill="none"
							stroke="currentColor"
							stroke-width="1.5"
							viewBox="0 0 24 24"
							xmlns="http://www.w3.org/2000/svg"
							aria-hidden="true"
						>
							<path
								stroke-linecap="round"
								stroke-linejoin="round"
								d="M16.023 9.348h4.992v-.001M2.985 19.644v-4.992m0 0h4.992m-4.993 0l3.181 3.183a8.25 8.25 0 0013.803-3.7M4.031 9.865a8.25 8.25 0 0113.803-3.7l3.181 3.182m0-4.991v4.99"
							></path>
						</svg>
						Refresh
					</button> -->
					<button
						type="button"
						data-open-modal="add-case-modal"
						class="inline-flex items-center justify-center w-1/2 px-3 py-2 text-sm font-medium text-center text-white rounded-lg bg-primary-700 hover:bg-primary-800 focus:ring-4 focus:ring-primary-300 sm:w-auto dark:bg-primary-600 dark:hover:bg-primary-700 dark:focus:ring-primary-800"
					>
						<svg
							class="w-5 h-5 mr-2 -ml-1"
							fill="currentColor"
							viewBox="0 0 20 20"
							xmlns="http://www.w3.org/2000/svg"
							><path
								fill-rule="evenodd"
								d="M10 5a1 1 0 011 1v3h3a1 1 0 110 2h-3v3a1 1 0 11-2 0v-3H6a1 1 0 110-2h3V6a1 1 0 011-1z"
								clip-rule="evenodd"></path></svg
						>
						<span data-i18n="cases.buttons.add">{t('cases.buttons.add')}</span>
					</button>
				</div>
			</div>
		</div>
	</div>
	<div class="flex flex-col">
		<div class="overflow-x-auto">
			<div class="inline-block min-w-full align-middle">
				<div class="overflow-hidden shadow">
					<table
						class="min-w-full divide-y divide-gray-200 table-fixed dark:divide-gray-600"
					>
						<thead class="bg-gray-100 dark:bg-gray-700">
							<tr>
								<th scope="col" class="p-4">
									<div class="flex items-center">
										<input
											id="checkbox-all"
											aria-describedby="checkbox-1"
											type="checkbox"
											class="w-4 h-4 border-gray-300 rounded bg-gray-50 focus:ring-3 focus:ring-primary-300 dark:focus:ring-primary-600 dark:ring-offset-gray-800 dark:bg-gray-700 dark:border-gray-600"
										/>
										<label for="checkbox-all" class="sr-only">checkbox</label>
									</div>
								</th>
								<th
									scope="col"
									class="p-4 text-xs font-medium text-left text-gray-500 uppercase dark:text-gray-400"
								>
									No.Case
								</th>
								<th
									scope="col"
									class="p-4 text-xs font-medium text-left text-gray-500 uppercase dark:text-gray-400"
								>
									Case
								</th>
								<th
									scope="col"
									class="p-4 text-xs font-medium text-left text-gray-500 uppercase dark:text-gray-400"
								>
									Customer
								</th>
								<th
									scope="col"
									class="p-4 text-xs font-medium text-left text-gray-500 uppercase dark:text-gray-400"
								>
									Email
								</th>
								<th
									scope="col"
									class="p-4 text-xs font-medium text-left text-gray-500 uppercase dark:text-gray-400"
								>
									Case Email
								</th>
								<th
									scope="col"
									class="p-4 text-xs font-medium text-left text-gray-500 uppercase dark:text-gray-400"
								>
									Status
								</th>
								<th
									scope="col"
									class="p-4 text-xs font-medium text-left text-gray-500 uppercase dark:text-gray-400"
								>
									Actions
								</th>
							</tr>
						</thead>
						<tbody
							id="table-body"
							class="bg-white divide-y divide-gray-200 dark:bg-gray-800 dark:divide-gray-700"
						>
							
						</tbody>
					</table>
				</div>
			</div>
		</div>
	</div>

	<!-- Edit Case Modal -->
	<EditCaseForm />

	<!-- Workflow Modal -->
	<Workflow />

	<!-- Add Case Modal -->
	<AddCaseForm />

	<!-- Add Customer Modal -->
	<AddCustomerForm />

	<!-- Delete Case Modal -->
	<DeleteCaseForm />

	<NavPagination />
</entities-crud>



<script type="module">
	import { mountCases } from '/src/modules/cases/cases.ui.ts';

	const el = document.getElementById('cases-root');

	if (el) {
	mountCases(el);
	} else {
	console.warn('[Cases] root element not found');
	}
</script>
