---
import FooterSidebar from './FooterSidebar.astro';
import LayoutCommon from './LayoutCommon.astro';
import NavBarSidebar from './NavBarSidebar.astro';
import SideBar from './SideBar.astro';

import { resolveSite } from '@/lib/resolveSite';
import { getPublicWebsiteSnapshot } from '@/services/public.website.service';

const site = resolveSite(Astro);

const snapshot = await getPublicWebsiteSnapshot(
  Astro.request,
  site
);

const locale = site?.locale ?? 'en';

const legal =
  snapshot?.legal?.[locale] ?? {};

const social =
snapshot?.social ?? [];
---

<LayoutCommon>
	<NavBarSidebar />

	<SideBar />

	<div class="flex pt-16 overflow-hidden bg-gray-50 dark:bg-gray-900">
		<div
			id="main-content"
			class="relative w-full h-full overflow-y-auto bg-gray-50 lg:ml-64 dark:bg-gray-900 min-h-screen"
		>
			<slot />

			<FooterSidebar
				social={social}
				legal={legal}
				locale={locale}
			/>
		</div>
	</div>

  <script>
    import { useAuth } from '@/hooks/useAuth.ts';

    const { isAuthenticated } = useAuth();

    if (!isAuthenticated()) {
      window.location.href = '/authentication/sign-in';
    }
  </script>

	<!-- Logout -->
	<script>
		import '@/modules/auth/logout.client.ts';
	</script>
</LayoutCommon>
