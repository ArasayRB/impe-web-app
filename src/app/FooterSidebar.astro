---
import CopyrightNotice from '../components/CopyrightNotice.astro';

interface SocialLink {
  platform?: string;
  url?: string;
  icon?: string;
  label?: string;
  sort_order?: number;
}

interface Props {
	social?: SocialLink[];
	legal: Record<string, any>;
	locale: string;
}

const {
	social = [],
	legal,
	locale,
} = Astro.props;

const sortedSocial =
  [...social].sort(
    (a, b) =>
      (a.sort_order ?? 0) -
      (b.sort_order ?? 0)
  );

	const legalLinks = [
  {
    key: 'privacy_policy',
    label: legal?.privacy_policy?.title ?? 'Privacy Policy',
    url: `/${locale}/legal/privacy-policy`,
    document: legal?.privacy_policy,
  },
  {
    key: 'terms_of_service',
    label: legal?.terms_of_service?.title ?? 'Terms of Service',
    url: `/${locale}/legal/terms-of-service`,
    document: legal?.terms_of_service,
  },
  {
    key: 'cookie_policy',
    label: legal?.cookie_policy?.title ?? 'Cookie Policy',
    url: `/${locale}/legal/cookie-policy`,
    document: legal?.cookie_policy,
  },
  {
    key: 'license',
    label: legal?.license?.title ?? 'License',
    url: `/${locale}/legal/license`,
    document: legal?.license,
  },
];

const terms = legal?.terms_of_service;
const privacy = legal?.privacy_policy;
const license = legal?.license;
const cookies = legal?.cookie_policy;
---

<footer
	class="p-4 my-6 mx-4 bg-white rounded-lg shadow md:flex md:items-center md:justify-between md:p-6 xl:p-8 dark:bg-gray-800"
>
	<ul class="flex flex-wrap items-center mb-6 space-y-1 md:mb-0">
		{
			legalLinks.length > 0 && (
							legalLinks.map((item) => (
								<li>
									<a
										href={item.url}
										class="mr-4 text-sm font-normal text-gray-500 hover:underline md:mr-6 dark:text-gray-400"
									>
										{item.label}
									</a>
								</li>
							))
				)
		}
	</ul>
	<div class="flex space-x-6 sm:justify-center">
		{
			sortedSocial.map((item) =>
				item.url ? (
					<a
						href={item.url}
						target="_blank"
						rel="noopener noreferrer"
						aria-label={item.label || item.platform || 'Social'}
						class="h-5 w-5 text-gray-500 hover:text-gray-900 dark:text-gray-400 dark:hover:text-white"
					>
						{
							item.icon && (
								<span set:html={item.icon}></span>
							)
						}
					</a>
				) : null
			)
		}
	</div>
</footer>

<CopyrightNotice />
