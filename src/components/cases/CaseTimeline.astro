---
const { events } = Astro.props;
---

<div class="case-timeline">

{events.map(event => (

<div class="timeline-item">

<div class="timeline-icon">
{event.event_type}
</div>

<div class="timeline-content">

<div class="timeline-header">

<span class="event-type">
{event.event_type}
</span>

<span class="event-date">
{new Date(event.created_at).toLocaleString()}
</span>

</div>

<div class="event-description">
{event.description}
</div>

</div>

</div>

))}

</div>

<style>

.case-timeline{
display:flex;
flex-direction:column;
gap:20px;
}

.timeline-item{
display:flex;
gap:15px;
}

.timeline-icon{
width:40px;
height:40px;
border-radius:50%;
background:#4f46e5;
color:white;
display:flex;
align-items:center;
justify-content:center;
font-size:12px;
}

.timeline-content{
background:#f8fafc;
padding:10px 15px;
border-radius:8px;
width:100%;
}

.timeline-header{
display:flex;
justify-content:space-between;
font-size:12px;
margin-bottom:5px;
}

.event-description{
font-size:14px;
}

</style>