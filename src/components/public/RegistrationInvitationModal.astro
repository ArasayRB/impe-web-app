
---
---

<dialog
  id="start-registration"
  aria-labelledby="registration-modal-title"
  aria-describedby="registration-modal-description"
  class="m-auto w-[calc(100%-2rem)] max-w-lg rounded-3xl border border-gray-200 bg-white p-0 text-gray-900 shadow-2xl backdrop:bg-gray-950/50 backdrop:backdrop-blur-sm"
>
  <div class="relative p-6 sm:p-8">
    <button
      type="button"
      data-registration-close
      aria-label="Cerrar"
      class="absolute right-4 top-4 inline-flex h-10 w-10 items-center justify-center rounded-full text-gray-500 transition hover:bg-gray-100 hover:text-gray-900 focus:outline-none focus:ring-2 focus:ring-[#0057B7]"
    >
      <svg
        aria-hidden="true"
        class="h-5 w-5"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
      >
        <path
          d="m18 6-12 12M6 6l12 12"
          stroke-linecap="round"
          stroke-linejoin="round"
        />
      </svg>
    </button>

    <div
      class="mb-5 flex h-12 w-12 items-center justify-center rounded-2xl bg-[#0057B7]/10 text-[#0057B7]"
      aria-hidden="true"
    >
      <svg
        class="h-6 w-6"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.8"
      >
        <rect x="3" y="5" width="18" height="14" rx="2" />
        <path
          d="m4 7 8 6 8-6"
          stroke-linecap="round"
          stroke-linejoin="round"
        />
      </svg>
    </div>

    <div id="registration-form-state">
      <p class="mb-2 text-sm font-bold uppercase tracking-wider text-[#0057B7]">
        TU PRIMER CASO ES GRATIS
      </p>

      <h2
        id="registration-modal-title"
        class="pr-8 text-2xl font-bold tracking-tight text-gray-950 sm:text-3xl"
      >
        Empieza con tu primer caso
      </h2>

      <p
        id="registration-modal-description"
        class="mt-3 text-base leading-7 text-gray-600"
      >
        Introduce tu correo electrónico y te enviaremos un enlace para crear tu
        cuenta y comenzar a gestionar tu primer caso.
      </p>

      <form
        id="registration-invitation-form"
        class="mt-7 space-y-4"
      >
        <div>
          <label
            for="registration-email"
            class="mb-2 block text-sm font-semibold text-gray-800"
          >
            Correo electrónico
          </label>

          <input
            id="registration-email"
            name="email"
            type="email"
            autocomplete="email"
            inputmode="email"
            placeholder="tu@despacho.com"
            required
            maxlength="255"
            class="block w-full rounded-xl border border-gray-300 bg-white px-4 py-3 text-base text-gray-900 outline-none transition placeholder:text-gray-400 focus:border-[#0057B7] focus:ring-2 focus:ring-[#0057B7]/20"
          />
        </div>

        <p
          id="registration-error"
          role="alert"
          aria-live="polite"
          hidden
          class="rounded-xl border border-red-200 bg-red-50 px-4 py-3 text-sm leading-6 text-red-700"
        ></p>

        <button
          type="submit"
          id="registration-submit"
          class="inline-flex min-h-12 w-full items-center justify-center gap-2 rounded-xl bg-[#0057B7] px-5 py-3 text-sm font-semibold text-white shadow-sm transition hover:bg-[#00479A] focus:outline-none focus:ring-2 focus:ring-[#0057B7] focus:ring-offset-2 disabled:cursor-not-allowed disabled:opacity-60"
        >
          <span id="registration-submit-label">Enviar enlace de registro</span>

          <svg
            id="registration-submit-spinner"
            hidden
            class="h-4 w-4 animate-spin"
            viewBox="0 0 24 24"
            fill="none"
            aria-hidden="true"
          >
            <circle
              class="opacity-25"
              cx="12"
              cy="12"
              r="10"
              stroke="currentColor"
              stroke-width="4"
            />
            <path
              class="opacity-75"
              fill="currentColor"
              d="M4 12a8 8 0 0 1 8-8V0C5.373 0 0 5.373 0 12h4z"
            />
          </svg>
        </button>

        <p class="text-center text-sm text-gray-500">
          Sin tarjeta de crédito · Sin fecha de vencimiento
        </p>
      </form>
    </div>

    <div id="registration-success-state" hidden>
      <div
        class="mb-5 flex h-12 w-12 items-center justify-center rounded-full bg-[#00A86B]/10 text-[#00A86B]"
        aria-hidden="true"
      >
        <svg
          class="h-6 w-6"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
        >
          <path
            d="m5 12 4 4L19 6"
            stroke-linecap="round"
            stroke-linejoin="round"
          />
        </svg>
      </div>

      <h2
        tabindex="-1"
        data-registration-success-heading
        class="text-2xl font-bold tracking-tight text-gray-950 sm:text-3xl"
      >
        Revisa tu correo
      </h2>

      <p class="mt-3 text-base leading-7 text-gray-600">
        Si la solicitud se procesó correctamente, recibirás un email con el
        enlace para continuar tu registro en IJOBA. Revisa también tu carpeta
        de correo no deseado.
      </p>

      <button
        type="button"
        data-registration-close
        class="mt-7 inline-flex min-h-12 w-full items-center justify-center rounded-xl bg-[#0057B7] px-5 py-3 text-sm font-semibold text-white transition hover:bg-[#00479A] focus:outline-none focus:ring-2 focus:ring-[#0057B7] focus:ring-offset-2"
      >
        Entendido
      </button>
    </div>
  </div>
</dialog>

<script>
  import {
    requestPublicRegistrationInvitation,
  } from '@/services/public.website.service';

  const modal = document.querySelector<HTMLDialogElement>(
    '#start-registration'
  );

  if (modal && !modal.dataset.initialized) {
    modal.dataset.initialized = 'true';

    const form = modal.querySelector<HTMLFormElement>(
      '#registration-invitation-form'
    );

    const emailInput = modal.querySelector<HTMLInputElement>(
      '#registration-email'
    );

    const submitButton = modal.querySelector<HTMLButtonElement>(
      '#registration-submit'
    );

    const submitLabel = modal.querySelector<HTMLElement>(
      '#registration-submit-label'
    );

    const spinner = modal.querySelector<HTMLElement>(
      '#registration-submit-spinner'
    );

    const errorMessage = modal.querySelector<HTMLParagraphElement>(
      '#registration-error'
    );

    const formState = modal.querySelector<HTMLElement>(
      '#registration-form-state'
    );

    const successState = modal.querySelector<HTMLElement>(
      '#registration-success-state'
    );

    const successHeading = modal.querySelector<HTMLElement>(
      '[data-registration-success-heading]'
    );

    function setLoading(loading: boolean) {
      if (submitButton) {
        submitButton.disabled = loading;
      }

      if (submitLabel) {
        submitLabel.textContent = loading
          ? 'Enviando...'
          : 'Enviar enlace de registro';
      }

      if (spinner) {
        spinner.hidden = !loading;
      }

      if (emailInput) {
        emailInput.readOnly = loading;
      }
    }

    function showError(message: string) {
      if (!errorMessage) return;

      errorMessage.textContent = message;
      errorMessage.hidden = false;
    }

    function resetModal() {
      form?.reset();

      if (formState) formState.hidden = false;
      if (successState) successState.hidden = true;

      if (errorMessage) {
        errorMessage.textContent = '';
        errorMessage.hidden = true;
      }

      setLoading(false);
    }

    function openModal() {
      if (!modal?.open) {
        modal?.showModal();
      }

      window.requestAnimationFrame(() => {
        emailInput?.focus();
      });
    }

    document
      .querySelectorAll<HTMLElement>('[data-registration-trigger]')
      .forEach((trigger) => {
        trigger.addEventListener('click', (event) => {
          event.preventDefault();
          openModal();
        });
      });

    modal
      .querySelectorAll<HTMLButtonElement>('[data-registration-close]')
      .forEach((button) => {
        button.addEventListener('click', () => {
          modal.close();
        });
      });

    modal.addEventListener('click', (event) => {
      if (event.target === modal) {
        modal.close();
      }
    });

    modal.addEventListener('close', resetModal);

    form?.addEventListener('submit', async (event) => {
      event.preventDefault();

      if (!form.reportValidity() || !emailInput) {
        return;
      }

      const email = emailInput.value.trim();

      if (!email) {
        showError('Introduce un correo electrónico válido.');
        emailInput.focus();
        return;
      }

      if (errorMessage) {
        errorMessage.textContent = '';
        errorMessage.hidden = true;
      }

      setLoading(true);

      try {
        await requestPublicRegistrationInvitation(
          window.location.host,
          { email }
        );

        if (formState) formState.hidden = true;
        if (successState) successState.hidden = false;

        window.requestAnimationFrame(() => {
          successHeading?.focus();
        });
      } catch (error) {
        showError(
          error instanceof Error
            ? error.message
            : 'No se pudo enviar la solicitud. Inténtalo de nuevo.'
        );
      } finally {
        setLoading(false);
      }
    });
  }
</script>
