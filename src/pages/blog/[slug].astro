---
import LayoutPublic from '../../app/LayoutPublic.astro';
//import Layout from '../../layouts/BaseLayout.astro';
export const prerender = false;
// 🧠 1️⃣ - Definimos getStaticPaths()
export async function getStaticPaths() {
  // Importa todos los archivos MDX del blog
  const posts = import.meta.glob('../../content/blog/*.mdx');

  // Retorna un array de objetos con sus slugs
  return Object.keys(posts).map((path) => {
    const slug = path?.split('/')?.pop()?.replace('.mdx', '');
    return { params: { slug } };
  });
}

// 🧠 2️⃣ - Cargamos el contenido del post según el slug
const { slug } = Astro.params;
const post = await import(`../../content/blog/${slug}.mdx`);
const { default: Content, frontmatter } = post;
---

<LayoutPublic
  title={frontmatter.title}
  description={frontmatter.description}
  image={frontmatter.image}
  url={`${import.meta.env.PUBLIC_SITE_URL}/blog/${slug}`}
  published={frontmatter.pubDate}
>
  <article class="max-w-3xl mx-auto py-12 prose dark:prose-invert">
    <h1>{frontmatter.title}</h1>
    <p class="text-gray-500 text-sm">
      {new Date(frontmatter.pubDate).toLocaleDateString('es-ES')}
    </p>
    <Content />
  </article>
</LayoutPublic>
