---
import LayoutSidebar from '@/app/LayoutSidebar.astro';
import CrudCaseTypes from '@/modules/case_types/CaseTypes.astro';
import { listCaseTypes } from '@/modules/case_types/casetypes.service';


import { resolveSite } from '@/lib/resolveSite';

let data;
let error = null;
const site = resolveSite(Astro);

try {
  data = await listCaseTypes(Astro.request, {}, site);
} catch (e:any) {console.log('Error message',e)
  error = e;
  data = {
    data: [],
    meta: {},
    error: {
      message: e.message || 'Request failed',
      code: e.code || 'UNKNOWN'
    }
  };
}
---

<LayoutSidebar>
	<CrudCaseTypes initialData={data} />
  <script>
    import { initModalEvents } from '@/lib/modal.events.ts';
    initModalEvents();
  </script>
</LayoutSidebar>
