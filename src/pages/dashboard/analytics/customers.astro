---
import LayoutSidebar from '@/app/LayoutSidebar.astro';
import CustomerAnalytics from
'@/modules/customers/CustomerAnalytics.astro';

import {
  getCustomersAnalytics
} from '@/modules/customers/customers.service';

import { resolveSite } from '@/lib/resolveSite';

const site = resolveSite(Astro);
var response={data:{}};

try {
  response =
    await getCustomersAnalytics({},Astro.request, site);

} catch (e:any) {

  if (
    e.code === 'UNAUTHENTICATED'
  ) {

    return Astro.redirect(
      '/authentication/sign-in'
    );
  }

  response.error = {
    code: e.code,
    message: e.message
  };
}

---

<LayoutSidebar>

  <CustomerAnalytics
    initialData={response.data}
  />

</LayoutSidebar>