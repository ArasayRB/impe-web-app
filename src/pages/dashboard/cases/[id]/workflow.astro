---
import LayoutSidebar from '@/app/LayoutSidebar.astro';
import CaseWorkflow from '@/modules/cases/CaseWorkflow.astro';

import { getWorkflow } from '@/modules/cases/cases.service';
import { resolveSite } from '@/lib/resolveSite';

export const prerender = false;

const { id } = Astro.params;

if (!id) {
	throw new Error('Missing case id');
}

const site = resolveSite(Astro);

let data;

try {

	data = await getWorkflow(
		id,
		Astro.request,
		site
	);

} catch (e: any) {

	console.error(
		'[CASE WORKFLOW]',
		e
	);

	throw e;
}
---

<LayoutSidebar>

	<CaseWorkflow
		initialData={data}
	/>

</LayoutSidebar>
