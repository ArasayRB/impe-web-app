---
import LayoutStacked from '../../app/LayoutStacked.astro';
import FormSignIn from '../../modules/FormSignIn.astro';
import { isBrowser } from '@/lib/env';
---

<LayoutStacked>
	<div class="min-h-screen align-middle flex pb-[12vh]">
		<FormSignIn />
	</div>
	
	<script type="module">
		import { getSession, clearSession } from '@/lib/session'; 
		import { initDevice } from '@/lib/device.store.ts'; 
		import { login, redirectToNoBusiness } from '@/modules/auth/auth.client.ts'; 
		import { handleLoginError } from '@/lib/error.handle.client.ts'; 
		import { initI18n } from '@/lib/i18n/i18n'; 
		import { setLocale } from '@/lib/i18n/store'; 
		import { lang } from '@/lib/i18n/config'; 
		import { loadNamespace } from '@/lib/i18n/loader';

		const locale =
		document.cookie.match(/locale=([^;]+)/)?.[1] || 'en';

		if(locale.length){
			setLocale(locale);

			await Promise.all(lang.map(trans => loadNamespace(locale, trans))); // KEY to translates
		}
		//localStorage.clear();
		//document.cookie.split(";").forEach(c => {
		//document.cookie = c
		//	.replace(/^ +/, "")
		//	.replace(/=.*/, "=;expires=" + new Date().toUTCString() + ";path=/");
		//});

		const form = document.getElementById('loginForm');
		const errorEl = document.getElementById('loginError');
		let isSubmitting = false;

		if (form) {
			form.addEventListener('submit', async (e) => {
				e.preventDefault();

				if (isSubmitting) return;
					isSubmitting = true;

				const btn = form.querySelector('button[type="submit"]');
				btn.disabled = true;

				errorEl.classList.add('hidden');

				try {
					const formData = new FormData(form);

					const email = formData.get('email');
					const password = formData.get('password');
					
					initDevice();

					const data = await login(email, password);
					
					if (!data) {
							return;
					}

					if (data.requires_2fa) {
						location.href = '/authentication/2fa';
						return;
					}
					// REAL VALIDATION
					if (!data?.access_token) {
						throw new Error('Invalid authentication response');
					}
					
					location.href = '/';
				} catch (e) {
					handleLoginError(e,errorEl);
				} finally {
					btn.disabled = false;
					isSubmitting = false;
				}
			});
		}
	</script>
</LayoutStacked>
