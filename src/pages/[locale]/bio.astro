---
import LayoutWebsite from '@/app/LayoutWebsite.astro';

import ContactSection from '@/modules/public-website/sections/ContactSection.astro';

import {
  getPublicWebsiteSnapshot,
} from '@/services/public.website.service';

import {
  isPublicWebsiteLocale
} from '@/lib/publicWebsiteLocale';

import { resolveSite } from '@/lib/resolveSite';


const isPublicWebsite =
  Astro.locals.isPublicWebsite === true;

const site =
  isPublicWebsite
    ? null
    : resolveSite(Astro);

const publicHost =
  site?.domain
    ? (
        site.subdomain
          ? `${site.subdomain}.${site.domain}`
          : site.domain
      )
    : undefined;


const snapshot =
  await getPublicWebsiteSnapshot(
    Astro.request,
    site
  );


const locale =
  Astro.params.locale;


/*
 * Resource associated with this /bio page.
 *
 * Example:
 *
 * /es/bio#comparativa_caso_conectado
 *
 * The hash is only for the public URL.
 * The API/resource uses the real slug.
 */
if (
  !locale ||
  !isPublicWebsiteLocale(locale) ||
  !snapshot
) {
  Astro.response.status = 404;
}


const contact =
  snapshot?.contact?.[locale] ?? [];

const resourceContactFields =
  contact.filter((field: any) => {
    return [
      'name',
      'email',
      'company',
      'privacy_consent',
    ].includes(field.key);
  });

const submission =
  snapshot?.contact?.submission;

const security =
  snapshot?.contact?.security;

const social =
  snapshot?.social ?? [];
---


{
  snapshot &&
  locale ? (

    <LayoutWebsite
      snapshot={snapshot}
      locale={locale}
    >

      <main>

        <!-- Marketing resource -->

        <section
          id="marketing-resource"
          class="relative overflow-hidden bg-white dark:bg-gray-950"
        >

          <div
            class="mx-auto max-w-5xl px-6 py-20 sm:py-28 lg:px-8"
          >

            <div class="max-w-3xl">

              <div
                class="mb-6 flex items-center gap-3"
                aria-hidden="true"
              >
                <span
                  class="h-px w-10 bg-gray-950 dark:bg-white"
                ></span>

                <span
                  class="h-1.5 w-1.5 rounded-full bg-gray-950 dark:bg-white"
                ></span>

                <span
                  class="h-px w-10 bg-gray-950 dark:bg-white"
                ></span>
              </div>


              <p
                class="text-sm font-semibold uppercase tracking-widest text-gray-500 dark:text-gray-400"
              >
                Recurso gratuito
              </p>


              <h1
									id="marketing-resource-title"
									class="mt-4 text-4xl font-bold tracking-tight text-gray-950 sm:text-5xl dark:text-white"
								>
									Cargando recurso...
								</h1>


              <p
								id="marketing-resource-description"
								class="mt-6 hidden text-lg leading-8 text-gray-600 dark:text-gray-300"
							></p>

							<p
								id="marketing-resource-status"
								class="mx-auto max-w-5xl px-6 pb-6 text-sm text-gray-600 dark:text-gray-300"
								role="status"
								aria-live="polite"
							>
								Cargando recurso...
							</p>

            </div>

          </div>

        </section>


        <!-- Download form -->

        <div
					id="marketing-resource-form-container"
					class="hidden"
				>
					<ContactSection
						section={{
							key: 'marketing-resource-form'
						}}
						fields={resourceContactFields}
						submission={submission}
						security={security}
						locale={locale}
						publicHost={publicHost}
						submitLabel="Descargar recurso"
					/>
				</div>

      </main>

    </LayoutWebsite>

  ) : (

    <main
      class="mx-auto max-w-4xl px-4 py-16"
    >

      <h1 class="text-3xl font-bold">
        Page not found
      </h1>

    </main>

  )
}


		<script>
			import {
				getPublicMarketingResource,
			} from '@/services/public.website.service';

			const title =
				document.querySelector<HTMLElement>(
					'#marketing-resource-title'
				);

			const description =
				document.querySelector<HTMLElement>(
					'#marketing-resource-description'
				);

			const status =
				document.querySelector<HTMLElement>(
					'#marketing-resource-status'
				);

			const formContainer =
				document.querySelector<HTMLElement>(
					'#marketing-resource-form-container'
				);

			const form =
				document.querySelector<HTMLFormElement>(
					'#public-contact-form'
				);

			let requestVersion = 0;
			let currentSlug = '';

			async function resolveMarketingResource() {
				const version = ++requestVersion;

				let slug = '';

				try {
					slug = decodeURIComponent(
						window.location.hash.slice(1)
					).trim();
				} catch {
					slug = '';
				}

				currentSlug = slug;

				if (
					!title ||
					!description ||
					!status ||
					!formContainer ||
					!form
				) {
					return;
				}

				formContainer.classList.add('hidden');
				status.classList.remove('hidden');
				status.textContent = 'Cargando recurso...';

				if (!slug) {
					title.textContent = 'Recurso gratuito';
					description.textContent = '';
					description.classList.add('hidden');
					status.textContent =
						'No se ha especificado el recurso que deseas descargar.';
					return;
				}

				try {
					const resource =
						await getPublicMarketingResource(slug);

					// Ignorar respuestas de solicitudes anteriores.
					if (version !== requestVersion) {
						return;
					}

					if (!resource) {
						throw new Error('Recurso no encontrado.');
					}

					title.textContent = resource.title;

					description.textContent =
						resource.description || '';

					description.classList.toggle(
						'hidden',
						!resource.description
					);

					// El slug autorizado procede del recurso devuelto por la API.
					form.dataset.marketingResourceSlug =
						resource.slug;

					// Si cambia el recurso, limpiar el estado de la descarga anterior.
					form.reset();

					form.parentElement
						?.querySelector('[data-resource-download]')
						?.remove();

					const submitButton =
						form.querySelector<HTMLButtonElement>(
							'#public-contact-submit'
						);

					if (submitButton) {
						submitButton.classList.remove('hidden');
						submitButton.disabled = false;
						submitButton.textContent =
							form.dataset.submitLabel || 'Descargar recurso';
					}

					const message =
						form.querySelector<HTMLElement>(
							'#public-contact-form-message'
						);

					if (message) {
						message.classList.add('hidden');
						message.textContent = '';
					}

					status.classList.add('hidden');
					formContainer.classList.remove('hidden');
				} catch (error) {
					if (version !== requestVersion) {
						return;
					}

					console.error(
						'[PUBLIC MARKETING RESOURCE] Error loading resource',
						{
							slug,
							error,
						}
					);

					title.textContent = 'Recurso no disponible';
					description.textContent = '';
					description.classList.add('hidden');

					status.textContent =
						'No se ha encontrado este recurso o no está disponible para descargar.';
				}
			}

			window.addEventListener(
				'hashchange',
				resolveMarketingResource
			);

			resolveMarketingResource();
		</script>
