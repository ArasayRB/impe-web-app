---
import LayoutWebsite from '@/app/LayoutWebsite.astro';

import ContactSection from '@/modules/public-website/sections/ContactSection.astro';

import {
  getPublicWebsiteSnapshot,
  getPublicMarketingResource,
} from '@/services/public.website.service';

import {
  isPublicWebsiteLocale
} from '@/lib/publicWebsiteLocale';

import { resolveSite } from '@/lib/resolveSite';


const isPublicWebsite =
  Astro.locals.isPublicWebsite === true;

const site =
  isPublicWebsite
    ? null
    : resolveSite(Astro);

const publicHost =
  site?.domain
    ? (
        site.subdomain
          ? `${site.subdomain}.${site.domain}`
          : site.domain
      )
    : undefined;


const snapshot =
  await getPublicWebsiteSnapshot(
    Astro.request,
    site
  );


const locale =
  Astro.params.locale;


/*
 * Resource associated with this /bio page.
 *
 * Example:
 *
 * /es/bio#comparativa_caso_conectado
 *
 * The hash is only for the public URL.
 * The API/resource uses the real slug.
 */
const marketingResourceSlug =
  'comparativa-caso-conectado';


const marketingResource =
  await getPublicMarketingResource(
    marketingResourceSlug
  );


if (
  !locale ||
  !isPublicWebsiteLocale(locale) ||
  !snapshot ||
  !marketingResource
) {
  Astro.response.status = 404;
}


const contact =
  snapshot?.contact?.[locale] ?? [];

const resourceContactFields =
  contact.filter((field: any) => {
    return [
      'name',
      'email',
      'company',
      'privacy_consent',
    ].includes(field.key);
  });

const submission =
  snapshot?.contact?.submission;

const security =
  snapshot?.contact?.security;

const social =
  snapshot?.social ?? [];
---


{
  snapshot &&
  locale &&
  marketingResource ? (

    <LayoutWebsite
      snapshot={snapshot}
      locale={locale}
    >

      <main>

        <!-- Marketing resource -->

        <section
          id="marketing-resource"
          class="relative overflow-hidden bg-white dark:bg-gray-950"
        >

          <div
            class="mx-auto max-w-5xl px-6 py-20 sm:py-28 lg:px-8"
          >

            <div class="max-w-3xl">

              <div
                class="mb-6 flex items-center gap-3"
                aria-hidden="true"
              >
                <span
                  class="h-px w-10 bg-gray-950 dark:bg-white"
                ></span>

                <span
                  class="h-1.5 w-1.5 rounded-full bg-gray-950 dark:bg-white"
                ></span>

                <span
                  class="h-px w-10 bg-gray-950 dark:bg-white"
                ></span>
              </div>


              <p
                class="text-sm font-semibold uppercase tracking-widest text-gray-500 dark:text-gray-400"
              >
                Recurso gratuito
              </p>


              <h1
                class="mt-4 text-4xl font-bold tracking-tight text-gray-950 sm:text-5xl dark:text-white"
              >
                {marketingResource.title}
              </h1>


              {
                marketingResource.description && (
                  <p
                    class="mt-6 text-lg leading-8 text-gray-600 dark:text-gray-300"
                  >
                    {marketingResource.description}
                  </p>
                )
              }

            </div>

          </div>

        </section>


        <!-- Download form -->

        <ContactSection
          section={{
            key: 'marketing-resource-form'
          }}
          fields={resourceContactFields}
          submission={submission}
          security={security}
          locale={locale}
          publicHost={publicHost}
          marketingResourceSlug={
            marketingResource.slug
          }
  				submitLabel="Descargar recurso"
        />

      </main>

    </LayoutWebsite>

  ) : (

    <main
      class="mx-auto max-w-4xl px-4 py-16"
    >

      <h1 class="text-3xl font-bold">
        Page not found
      </h1>

    </main>

  )
}
