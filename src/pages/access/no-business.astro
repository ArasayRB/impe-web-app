---
import LayoutStacked from '../../app/LayoutStacked.astro';
import { getServerTranslator } from '@/lib/i18n/server';
import { lang } from '@/lib/i18n/config';
import { resolveLocale } from '@/lib/i18n/resolveLocale';


const locale = resolveLocale(Astro);

const t = await getServerTranslator(locale, lang);
---

<LayoutStacked>
	<div class="min-h-screen flex items-center justify-center px-6">
		<div class="max-w-md text-center">

			<h1 class="text-2xl font-semibold  text-gray-700 dark:text-gray-300">
				{t('common.messages.access_unavailable')}
			</h1>

			<p class="mt-3 text-gray-500  dark:text-gray-300">
				{t('common.messages.user_not_associated_to_business')}
				{t('common.messages.not_access_to_platform')}
			</p>

			<p class="mt-3 text-gray-500  dark:text-gray-300">
				{t('common.messages.contact_administrator_for_access')}
			</p>

			<button
				type="button"
				onclick="window.location.href='/authentication/sign-in'"
				class="mt-6 rounded-lg px-4 py-2 text-sm font-medium shadow  text-gray-700 hover:text-primary-600 dark:text-gray-300 dark:hover:text-white"
			>
				{t('common.messages.back_to_sign')}
			</button>

		</div>
	</div>
</LayoutStacked>
